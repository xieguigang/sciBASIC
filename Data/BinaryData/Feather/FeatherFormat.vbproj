<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OptionInfer>On</OptionInfer>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AllowUnsafeBlocks>False</AllowUnsafeBlocks>
    <Version>0.6.9742.7537</Version>
    <Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
    <Company>sciBASIC.NET Foundation</Company>
    <Product>FeatherDotNet</Product>
    <Description>A VB.NET port of the Feather columnar file format, built on an embedded FlatBuffers runtime. Reads and writes typed and untyped data frames with row/column access, null handling, and categorical or timestamp metadata.</Description>
    <PackageReleaseNotes>Update to target netcoreapp2.0</PackageReleaseNotes>
    <Platforms>AnyCPU;x64</Platforms>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(ProjectDir)**\*.cs</DefaultItemExcludes>
    <RootNamespace>Microsoft.VisualBasic.DataStorage.FeatherFormat</RootNamespace>
    <AssemblyName>Microsoft.VisualBasic.DataStorage.FeatherFormat</AssemblyName>
    <RemoveIntegerChecks>True</RemoveIntegerChecks>
    <UseApplicationFramework>True</UseApplicationFramework>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <Configurations>Debug;Release;Rsharp_app_release;nuget_release;CellaLAB-Desktop</Configurations>
    <AssemblyVersion>1.0.9742.7537</AssemblyVersion>
    <Title>Feather Columnar Data Frame File Format Reader and Writer</Title>
    <AssemblyTitle>Microsoft.VisualBasic.DataStorage.FeatherFormat</AssemblyTitle>
    <Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
    <PackageTags>scibasic;feather;arrow;columnar;dataframe;flatbuffers</PackageTags>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageIcon>logo-knot.png</PackageIcon>
    <PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../../.nuget/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="test\**" />
    <EmbeddedResource Remove="test\**" />
    <None Remove="test\**" />
    <None Include="..\..\..\vs_solutions\logo-knot.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Composition" Version="10.0.11" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\BinaryData\binarydata-netcore5.vbproj" />
  </ItemGroup>
</Project>
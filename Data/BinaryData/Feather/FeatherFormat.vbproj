<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OptionInfer>On</OptionInfer>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AllowUnsafeBlocks>False</AllowUnsafeBlocks>
    <Version>0.6.9742.6623</Version>
    <Authors>Kevin Montrose</Authors>
    <Company>Kevin Montrose</Company>
    <Product>FeatherDotNet</Product>
    <Description>An implementation of the Feather format for .NET.</Description>
    <PackageReleaseNotes>Update to target netcoreapp2.0</PackageReleaseNotes>
    <Platforms>AnyCPU;x64</Platforms>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(ProjectDir)**\*.cs</DefaultItemExcludes>
    <RootNamespace>Microsoft.VisualBasic.DataStorage.FeatherFormat</RootNamespace>
    <AssemblyName>Microsoft.VisualBasic.DataStorage.FeatherFormat</AssemblyName>
    <RemoveIntegerChecks>True</RemoveIntegerChecks>
    <UseApplicationFramework>True</UseApplicationFramework>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <Configurations>Debug;Release;Rsharp_app_release;nuget_release;CellaLAB-Desktop</Configurations>
    <AssemblyVersion>1.0.9742.6623</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="test\**" />
    <EmbeddedResource Remove="test\**" />
    <None Remove="test\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Composition" Version="10.0.11" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\BinaryData\binarydata-netcore5.vbproj" />
  </ItemGroup>
</Project>
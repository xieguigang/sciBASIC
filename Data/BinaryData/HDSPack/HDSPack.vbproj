<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.VisualBasic.DataStorage.HDSPack</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>Microsoft.VisualBasic.DataStorage.HDSPack</AssemblyName>
    <Description>A packable virtual file system that stores many named streams, folders and attributes inside a single binary file: block allocation, buffered read and write, file deletion, MessagePack encoded metadata trees and read-only mounting for dataset archives.</Description>
	  <Platforms>AnyCPU;x64</Platforms>
	  <Configurations>Debug;Release;LipidSearch;Rsharp_app_release;mzkit;PlantMAT;NPSearch;mzkit_win32;gcmodeller_desktop;CFD_win32;nuget_release;MEMI-Desktop;CellaLAB-Desktop</Configurations>
	  <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
	  <GenerateDocumentationFile>True</GenerateDocumentationFile>
	  <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>1.0.9762.11310</Version>
    <AssemblyVersion>1.0.9762.11310</AssemblyVersion>
    <Title>StreamPack Virtual File System in a Single Binary File</Title>
    <AssemblyTitle>Microsoft.VisualBasic.DataStorage.HDSPack</AssemblyTitle>
    <Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
    <Company>sciBASIC.NET Foundation</Company>
    <Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
    <PackageTags>scibasic;hdspack;virtual-filesystem;stream-pack;archive;binary-format;container</PackageTags>
    <PackageReleaseNotes>StreamPack, the single file virtual file system of sciBASIC#. It stores many named streams, folders and attributes inside one binary file - an HDF5 like container used for dataset archives. Hierarchy: StreamPack is the pack file itself, StreamGroup a folder node, and StreamBlock a stored file reference carrying its offset, size, MIME type and extension. I/O: Allocate reserves a BufferRegion, OpenBlock returns a seekable Stream over that region (or an in-memory StreamBuffer flushed to the underlying stream on Dispose), and the root namespace extensions provide WriteText, ReadText, ReadBinary, LoadStream and ListFiles conveniences. Metadata: the metadata tree is serialized through TreeParser and TreeWriter, while AttributeMetadata, LazyAttribute and PackAttributeData store named attributes encoded with MessagePack. Access modes: StreamPack.OpenReadOnly mounts an existing pack without modification, and listing, deletion, size and modification time helpers are included. This format is what the sciBASIC# data framework uses when a dataset has to ship as a single portable file.</PackageReleaseNotes>
    <PackageIcon>logo-knot.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <RemoveIntegerChecks>true</RemoveIntegerChecks>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <OutputPath>../../../.nuget/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="test\**" />
    <EmbeddedResource Remove="test\**" />
    <None Remove="test\**" />
    <None Include="..\..\..\vs_solutions\logo-knot.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\BinaryData\binarydata-netcore5.vbproj" />
    <ProjectReference Include="..\msgpack\msgpack-netcore5.vbproj" />
  </ItemGroup>

</Project>

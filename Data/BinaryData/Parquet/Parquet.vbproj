<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.VisualBasic.DataStorage.Parquet</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Microsoft.VisualBasic.DataStorage.Parquet</AssemblyName>
    <AssemblyTitle>Pure VB.NET implementation of the Apache Parquet columnar data file format</AssemblyTitle>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Apache Parquet columnar data file format (pure VB.NET implementation)</Title>
    <Description>A pure VB.NET implementation of the Apache Parquet columnar file format, without any native (parquet-mr / arrow) dependency. Supports thrift compact protocol metadata, PLAIN values with RLE bit-packed hybrid levels on write, PLAIN / dictionary / DELTA / BYTE_STREAM_SPLIT / RLE decoding on read, DataPageV1 writing and DataPageV1+V2 reading, UNCOMPRESSED / SNAPPY / GZIP page compression, row groups, column statistics and LIST / MAP / STRUCT nested schemas. Reads and writes Microsoft.VisualBasic.Data.Framework.DataFrame objects.</Description>
    <PackageTags>scibasic;parquet;columnar;dataframe;apache</PackageTags>
    <Version>1.0.0</Version>
    <Authors>sciBASIC.NET Foundation</Authors>
    <Company>sciBASIC.NET Foundation</Company>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="test\**" />
    <EmbeddedResource Remove="test\**" />
    <None Remove="test\**" />
    <Compile Remove="bin\**" />
    <Compile Remove="obj\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\DataFrame\dataframework-netcore5.vbproj" />
    <ProjectReference Include="..\BinaryData\binarydata-netcore5.vbproj" />
  </ItemGroup>

</Project>

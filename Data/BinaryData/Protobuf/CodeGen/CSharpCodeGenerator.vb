Option Strict On
Option Explicit On
Option Infer On

' /********************************************************************************/
'  Microsoft.VisualBasic.Data.IO.Protobuf
'  Data\BinaryData\Protobuf\CodeGen\CSharpCodeGenerator.vb
' /********************************************************************************/

Imports Microsoft.VisualBasic.Data.IO.Protobuf.Schema

Namespace CodeGen

    ''' <summary>
    ''' 从 .proto 描述符树生成 C# 实体类源码。
    ''' </summary>
    ''' <remarks>
    ''' 生成的类型带有 <c>[ProtoContract]</c> / <c>[ProtoMember(n)]</c> 标注，
    ''' 可直接被 <c>ProtoSerializer</c> 序列化。嵌套消息被展平为
    ''' <c>Parent_Child</c> 形式的顶层类型。
    ''' </remarks>
    Public Class CSharpCodeGenerator : Inherits ProtoCodeGeneratorBase

        Public Overrides ReadOnly Property Language As CodeLanguage
            Get
                Return CodeLanguage.CSharp
            End Get
        End Property

        Protected Overrides ReadOnly Property FileExtension As String
            Get
                Return ".cs"
            End Get
        End Property

        Protected Overrides ReadOnly Property DocPrefix As String
            Get
                Return "///"
            End Get
        End Property

        Protected Overrides Sub WriteFileHeader(writer As CodeWriter, sourceName As String)
            Call writer.WriteLine("// <auto-generated>")
            Call writer.WriteLine($"//     本文件由 Microsoft.VisualBasic.Data.IO.Protobuf 代码生成器根据 '{sourceName}' 生成。")
            Call writer.WriteLine("//     请勿手工修改；重新生成会覆盖全部内容。")
            Call writer.WriteLine("// </auto-generated>")
        End Sub

        Protected Overrides Sub WriteImports(writer As CodeWriter)
            Call writer.WriteLine("using System;")
            Call writer.WriteLine("using System.Collections.Generic;")
            Call writer.WriteLine("using Microsoft.VisualBasic.Data.IO.Protobuf.Serialization;")
        End Sub

        Protected Overrides Sub WriteNamespaceOpen(writer As CodeWriter, name As String)
            Call writer.WriteLine($"namespace {name}")
            Call writer.WriteLine("{")
        End Sub

        Protected Overrides Sub WriteNamespaceClose(writer As CodeWriter, name As String)
            Call writer.WriteLine("}")
        End Sub

        Protected Overrides Sub WriteEnumDeclaration(writer As CodeWriter, item As EnumDescriptor, clrName As String)
            Call writer.WriteLine($"public enum {EscapeName(clrName)}")
            Call writer.WriteLine("{")
            Call writer.Indent()

            For i As Integer = 0 To item.Values.Count - 1
                Dim value As EnumValueDescriptor = item.Values(i)
                Dim comma As String = If(i < item.Values.Count - 1, ",", "")

                Call writer.WriteLine($"{EscapeName(value.Name)} = {value.Number}{comma}")
            Next

            Call writer.Dedent()
            Call writer.WriteLine("}")
        End Sub

        Protected Overrides Sub WriteMessageDeclaration(writer As CodeWriter, message As MessageDescriptor, clrName As String)
            Call writer.WriteLine(AttributeText("ProtoContract"))
            Call writer.WriteLine($"public class {EscapeName(clrName)}")
            Call writer.WriteLine("{")
            Call writer.Indent()
            Call WriteMembers(writer, message)
            Call writer.Dedent()
            Call writer.WriteLine("}")
        End Sub

        Protected Overrides Sub WritePropertyDeclaration(writer As CodeWriter, field As FieldDescriptor)
            Dim typeName As String = GetMemberType(field)
            Dim initializer As String = GetMemberInitializer(field)
            Dim line As String =
                $"public {typeName} {EscapeName(NamingHelper.ToPascalCase(field.Name))} {{ get; set; }}"

            If Not String.IsNullOrEmpty(initializer) Then
                line &= $" = {initializer};"
            End If

            Call writer.WriteLine(line)
        End Sub

        Protected Overrides Function AttributeText(text As String) As String
            Return $"[{text}]"
        End Function

        Protected Overrides Function NamedArgument(name As String, value As String) As String
            Return $"{name} = {value}"
        End Function

        Protected Overrides Function BoolLiteral(value As Boolean) As String
            Return If(value, "true", "false")
        End Function

        Protected Overrides Function GetScalarType(kind As FieldTypeKind) As String
            Select Case kind
                Case FieldTypeKind.Int32, FieldTypeKind.SInt32, FieldTypeKind.SFixed32
                    Return "int"
                Case FieldTypeKind.UInt32, FieldTypeKind.Fixed32
                    Return "uint"
                Case FieldTypeKind.Int64, FieldTypeKind.SInt64, FieldTypeKind.SFixed64
                    Return "long"
                Case FieldTypeKind.UInt64, FieldTypeKind.Fixed64
                    Return "ulong"
                Case FieldTypeKind.Float
                    Return "float"
                Case FieldTypeKind.[Double]
                    Return "double"
                Case FieldTypeKind.Bool
                    Return "bool"
                Case FieldTypeKind.[String]
                    Return "string"
                Case FieldTypeKind.Bytes
                    Return "byte[]"
                Case FieldTypeKind.Decimal128
                    Return "decimal"
                Case FieldTypeKind.DateTimeUnixMilliseconds, FieldTypeKind.DateTimeTicks
                    Return "DateTime"
                Case FieldTypeKind.Guid128
                    Return "Guid"
                Case Else
                    Return "object"
            End Select
        End Function

        Protected Overrides Function GetListType(elementType As String) As String
            Return $"List<{elementType}>"
        End Function

        Protected Overrides Function GetMapType(keyType As String, valueType As String) As String
            Return $"Dictionary<{keyType}, {valueType}>"
        End Function

        Protected Overrides Function EscapeName(name As String) As String
            Return NamingHelper.Escape(name, CodeLanguage.CSharp)
        End Function

        Protected Overrides Function GetMemberType(field As FieldDescriptor) As String
            If field.IsMap Then
                Dim keyType As String = GetFieldTypeName(field.MapKeyType, Nothing)
                Dim valueType As String = GetFieldTypeName(field.MapValueType, field.MapValueResolvedTypeFullName)

                Return GetMapType(keyType, valueType)
            End If

            Dim element As String = GetFieldTypeName(field.FieldType, field.ResolvedTypeFullName)

            If field.Label = FieldLabel.Repeated Then
                Return GetListType(element)
            Else
                Return element
            End If
        End Function

        Protected Overrides Function GetMemberInitializer(field As FieldDescriptor) As String
            If field.IsMap OrElse field.Label = FieldLabel.Repeated Then
                Return $"new {GetMemberType(field)}()"
            Else
                Return ""
            End If
        End Function

    End Class

End Namespace

Option Strict On
Option Explicit On
Option Infer On

' /********************************************************************************/
'  Microsoft.VisualBasic.Data.IO.Protobuf.test
'  Data\BinaryData\Protobuf\test\CodeGenTests.vb
' /********************************************************************************/

Imports System
Imports System.Collections.Generic
Imports System.IO
Imports Microsoft.VisualBasic.Data.IO.Protobuf.CodeGen
Imports Microsoft.VisualBasic.Data.IO.Protobuf.Schema

''' <summary>
''' 代码生成测试：VB / C# 产物结构、命名转换、关键字转义、文件拆分与落盘。
''' </summary>
Friend Module CodeGenTests

    Friend Sub Run()
        Dim file As ProtoFile = ProtoFile.LoadText(SampleProto.Text, "sample.proto")
        Dim vb As String = ProtoCodeGenerator.Generate(file, CodeLanguage.VB)
        Dim cs As String = ProtoCodeGenerator.Generate(file, CodeLanguage.CSharp)

        Call VbOutput(vb)
        Call CSharpOutput(cs)
        Call FileSplit(file)
        Call WriteToDirectory(file)
        Call FromProtoText()
    End Sub

#Region "CASES"

    Private Sub VbOutput(code As String)
        Call AssertContains(code, "' <auto-generated>", "VB：自动生成头注释")
        Call AssertContains(code, "sample.proto", "VB：头部注明源文件")
        Call AssertContains(code, "Imports System.Collections.Generic", "VB：集合命名空间导入")
        Call AssertContains(code, "Imports Microsoft.VisualBasic.Data.IO.Protobuf.Serialization", "VB：序列化命名空间导入")
        Call AssertContains(code, "Namespace Demo.Shop", "VB：package 映射为命名空间")
        Call AssertContains(code, "End Namespace", "VB：命名空间闭合")
        Call AssertContains(code, "<ProtoContract>", "VB：契约特性")
        Call AssertContains(code, "<ProtoMember(1)>", "VB：字段特性")
        Call AssertContains(code, "Public Property OrderId As String", "VB：snake_case 转 PascalCase")
        Call AssertContains(code, "Public Property Sku As String", "VB：嵌套消息字段")
        Call AssertContains(code, "List(Of String)", "VB：repeated 映射为 List")
        Call AssertContains(code, "List(Of Customer_PhoneNumber)", "VB：repeated 消息映射")
        Call AssertContains(code, "Dictionary(Of String, String)", "VB：map 映射为 Dictionary")
        Call AssertContains(code, "<ProtoMember(4, IsMap:=True)>", "VB：map 字段标注 IsMap")
        Call AssertContains(code, "<ProtoMember(5, IsPacked:=True)>", "VB：显式 packed 标注")
        Call AssertContains(code, "Public Property [Class] As String", "VB：关键字字段名被转义")
        Call AssertContains(code, "Public Property [Operator] As Integer", "VB：关键字字段名被转义（二）")
        Call AssertContains(code, "Public Property [End] As String", "VB：关键字字段名被转义（三）")
        Call AssertContains(code, "Public Enum OrderStatus", "VB：枚举生成")
        Call AssertContains(code, "STATUS_CLOSED = 9", "VB：枚举取值生成")
        Call AssertContains(code, "Public Class Customer_PhoneNumber", "VB：嵌套消息展平命名")
        Call AssertContains(code, "= New List(Of String)()", "VB：集合属性带初始化器")
        Call AssertContains(code, "Public Property Total As Double", "VB：double 字段映射")
    End Sub

    Private Sub CSharpOutput(code As String)
        Call AssertContains(code, "// <auto-generated>", "C#：自动生成头注释")
        Call AssertContains(code, "using System.Collections.Generic;", "C#：集合命名空间导入")
        Call AssertContains(code, "using Microsoft.VisualBasic.Data.IO.Protobuf.Serialization;", "C#：序列化命名空间导入")
        Call AssertContains(code, "namespace Demo.Shop", "C#：命名空间")
        Call AssertContains(code, "[ProtoContract]", "C#：契约特性")
        Call AssertContains(code, "[ProtoMember(1)]", "C#：字段特性")
        Call AssertContains(code, "public string OrderId { get; set; }", "C#：属性语法")
        Call AssertContains(code, "public List<string> Tags { get; set; } = new List<string>();", "C#：集合属性初始化器")
        Call AssertContains(code, "Dictionary<string, int>", "C#：map 映射为 Dictionary")
        Call AssertContains(code, "[ProtoMember(4, IsMap = true)]", "C#：map 字段标注 IsMap")
        Call AssertContains(code, "public enum OrderStatus", "C#：枚举生成")
        Call AssertContains(code, "Customer_PhoneNumber", "C#：嵌套消息展平命名")
    End Sub

    Private Sub FileSplit(file As ProtoFile)
        Dim files As Dictionary(Of String, String) = ProtoCodeGenerator.GenerateFiles(file, CodeLanguage.VB)

        Call AssertEqual(4, files.Count, "按顶层类型拆分文件（3 个消息 + 1 个枚举文件）")
        Call AssertTrue(files.ContainsKey("Customer.vb"), "Customer.vb 存在")
        Call AssertTrue(files.ContainsKey("Order.vb"), "Order.vb 存在")
        Call AssertTrue(files.ContainsKey("KeywordSample.vb"), "KeywordSample.vb 存在")
        Call AssertTrue(files.ContainsKey("ProtobufEnums.vb"), "枚举文件存在")
        Call AssertContains(files("Order.vb"), "Public Class Order", "Order.vb 含 Order 类")
        Call AssertContains(files("Order.vb"), "Public Class Order_Item", "Order.vb 含展平的嵌套类")
        Call AssertFalse(files("Customer.vb").Contains("Public Class Order"), "Customer.vb 不包含其他顶层类型")

        Dim csFiles As Dictionary(Of String, String) = ProtoCodeGenerator.GenerateFiles(file, CodeLanguage.CSharp)

        Call AssertTrue(csFiles.ContainsKey("Order.cs"), "C# 文件扩展名为 .cs")
    End Sub

    Private Sub WriteToDirectory(file As ProtoFile)
        Dim dir As String = TempDir()
        Dim paths As IReadOnlyList(Of String) = ProtoCodeGenerator.GenerateToDirectory(file, dir, CodeLanguage.VB)

        Call AssertEqual(4, paths.Count, "落盘文件数量")

        For Each path As String In paths
            Call AssertTrue(IO.File.Exists(path), $"文件已写入：{IO.Path.GetFileName(path)}")
            Call AssertTrue(New FileInfo(path).Length > 0, $"文件非空：{IO.Path.GetFileName(path)}")
        Next

        Dim csDir As String = TempDir()
        Dim csPaths As IReadOnlyList(Of String) = ProtoCodeGenerator.GenerateToDirectory(file, csDir, CodeLanguage.CSharp)

        Call AssertEqual(4, csPaths.Count, "C# 落盘文件数量")
    End Sub

    Private Sub FromProtoText()
        Dim code As String = ProtoCodeGenerator.GenerateFromProtoText(
            "syntax = ""proto3""; package tiny; message Ping { int32 value = 1; }",
            CodeLanguage.VB, "tiny.proto")

        Call AssertContains(code, "Public Class Ping", "一步生成源码")
        Call AssertContains(code, "Public Property Value As Integer", "一步生成字段")
        Call AssertContains(code, "Namespace Tiny", "package 转命名空间")
    End Sub

#End Region

End Module

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.VisualBasic.DataStorage.netCDF</RootNamespace>
       <AssemblyName>Microsoft.VisualBasic.DataStorage.netCDF</AssemblyName>

    <TargetFrameworks>net10.0</TargetFrameworks>
	  <Platforms>AnyCPU;x64</Platforms>
	  <Configurations>Debug;Release;LipidSearch;PlantMAT;mzkit;NPSearch;Rsharp_app_release;gcmodeller_desktop;nuget_release;MEMI-Desktop;CellaLAB-Desktop</Configurations>
	  <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
	  <GenerateDocumentationFile>True</GenerateDocumentationFile>
	  <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>1.0.9742.7537</Version>
    <AssemblyVersion>1.0.9742.7537</AssemblyVersion>
    <Title>netCDF Scientific Array Data File Reader and Writer</Title>
    <Description>Reads and writes netCDF files for array oriented scientific data, handling dimensions, record dimensions, global and variable attributes, and typed data vectors over byte, short, integer, float and double.</Description>
    <AssemblyTitle>Microsoft.VisualBasic.DataStorage.netCDF</AssemblyTitle>
    <Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
    <Company>sciBASIC.NET Foundation</Company>
    <Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
    <PackageTags>scibasic;netcdf;scientific-data;array-data;dimensions;variables</PackageTags>
    <PackageIcon>logo-knot.png</PackageIcon>
  </PropertyGroup>

  	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
		<PlatformTarget>x64</PlatformTarget>
		<RemoveIntegerChecks>true</RemoveIntegerChecks>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>				
		<OutputPath>../../../.nuget/</OutputPath>
	</PropertyGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\BinaryData\binarydata-netcore5.vbproj" />
    <None Include="..\..\..\vs_solutions\logo-knot.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>

      <Platform Solution="*|x64" Project="x64" />
    </Project>
  </Folder>
  <Project Path="MyersDiff/MyersDiff.vbproj">
    <Platform Solution="*|x64" Project="x64" />
  </Project>
  <Project Path="MyersDiff/test/test.vbproj">

<Solution>
  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="nuget_release" />
    <BuildType Name="Rsharp_app_release" />
    <Platform Name="Any CPU" />
    <Platform Name="x64" />
  </Configurations>
  <Folder Name="/framework/">

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.VisualBasic.DataMining.BinaryTree</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>Microsoft.VisualBasic.DataMining.BinaryTreeClustering</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;LipidSearch;Rsharp_app_release;mzkit_win32;gcmodeller_desktop;nuget_release;CellaLAB-Desktop</Configurations>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>AVL Binary Tree Clustering with Newick Tree Output</Title>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>logo-knot.png</PackageIcon>
    <Version>1.0.9758.20045</Version>
    <AssemblyVersion>1.0.9758.20045</AssemblyVersion>
    <Description>Clusters vector data by inserting items into an AVL binary tree under a fuzzy similarity comparison, then cutting the tree into partitions. Also offers Newick tree parsing, affinity propagation and KNN graph helpers.</Description>
    <AssemblyTitle>Microsoft.VisualBasic.DataMining.BinaryTreeClustering</AssemblyTitle>
    <Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
    <Company>sciBASIC.NET Foundation</Company>
    <Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
    <PackageTags>scibasic;clustering;binary-tree;avl-tree;newick;diffusion-map;knn-graph;affinity-propagation</PackageTags>
    <PackageReleaseNotes>AVL binary tree clustering for sciBASIC#. BuildTree inserts vector items into an AVL tree under a fuzzy similarity comparison, and Partitioning cuts the resulting tree into clusters; DiffusionMap adds diffusion map embedding, KNNGraph builds k nearest neighbour graphs, and newickParser reads and writes Newick tree text so dendrograms can round trip through standard tree formats. The AffinityPropagation namespace adds affinity propagation clustering, which selects exemplars directly from a similarity matrix without requiring a preset cluster count. The package is used by the hierarchical clustering and visualization layers whenever a similarity driven tree has to be produced from raw feature vectors.</PackageReleaseNotes>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineConstants>netcore5=1</DefineConstants>
    <DocumentationFile>Microsoft.VisualBasic.DataMining.BinaryTreeClustering.xml</DocumentationFile>
  </PropertyGroup>

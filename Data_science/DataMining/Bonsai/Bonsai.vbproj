<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>Microsoft.VisualBasic.DataMining.Bonsai</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
		<AssemblyName>Microsoft.VisualBasic.DataMining.Bonsai</AssemblyName>
		<Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
		<Company>sciBASIC.NET Foundation</Company>
		<Version>5.0.9742.7537</Version>
		<Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
		<PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
		<PackageIcon>logo-knot.png</PackageIcon>
		<RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
		<Platforms>AnyCPU;x64</Platforms>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Configurations>Debug;Release;LipidSearch;Rsharp_app_release;mzkit;gcmodeller_desktop;nuget_release</Configurations>
		<Description>Reconstructs a diffusion tree from high-dimensional observations, optimising every branch length and internal node coordinate against a Felsenstein tree likelihood, then laying the tree out for visualisation in sciBASIC#.</Description>
		<RepositoryType>git</RepositoryType>
		<AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<Title>Bonsai Diffusion Tree Layout for High-Dimensional Data</Title>
		<IncludeSymbols>True</IncludeSymbols>
		<AssemblyVersion>1.0.9742.7537</AssemblyVersion>
		<AssemblyTitle>Microsoft.VisualBasic.DataMining.Bonsai</AssemblyTitle>
		<PackageTags>scibasic;bonsai;dimensionality-reduction;diffusion-tree;visualization</PackageTags>
		<PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0|AnyCPU'">
	  <RemoveIntegerChecks>True</RemoveIntegerChecks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0|x64'">
	  <RemoveIntegerChecks>True</RemoveIntegerChecks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0|AnyCPU'">
	  <RemoveIntegerChecks>True</RemoveIntegerChecks>
	  <Optimize>False</Optimize>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0|x64'">
	  <RemoveIntegerChecks>True</RemoveIntegerChecks>
	  <Optimize>False</Optimize>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='LipidSearch|net10.0|AnyCPU'">
	  <RemoveIntegerChecks>True</RemoveIntegerChecks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='LipidSearch|net10.0|x64'">
	  <RemoveIntegerChecks>True</RemoveIntegerChecks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Rsharp_app_release|net10.0|AnyCPU'">
	  <RemoveIntegerChecks>True</RemoveIntegerChecks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Rsharp_app_release|net10.0|x64'">
	  <RemoveIntegerChecks>True</RemoveIntegerChecks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='mzkit|net10.0|AnyCPU'">
	  <RemoveIntegerChecks>True</RemoveIntegerChecks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='mzkit|net10.0|x64'">
	  <RemoveIntegerChecks>True</RemoveIntegerChecks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='gcmodeller_desktop|net10.0|AnyCPU'">
	  <RemoveIntegerChecks>True</RemoveIntegerChecks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='gcmodeller_desktop|net10.0|x64'">
	  <RemoveIntegerChecks>True</RemoveIntegerChecks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='nuget_release|net10.0|AnyCPU'">
	  <RemoveIntegerChecks>True</RemoveIntegerChecks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='nuget_release|net10.0|x64'">
	  <RemoveIntegerChecks>True</RemoveIntegerChecks>
	  <OutputPath>../../../.nuget/</OutputPath>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="bonsai_py\**" />
	  <Compile Remove="test\**" />
	  <Compile Remove="Verify\**" />
	  <EmbeddedResource Remove="bonsai_py\**" />
	  <EmbeddedResource Remove="test\**" />
	  <EmbeddedResource Remove="Verify\**" />
	  <None Remove="bonsai_py\**" />
	  <None Remove="test\**" />
	  <None Remove="Verify\**" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Bonsai.md" />
	  <None Remove="s41587-026-03220-2.pdf" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\..\..\LICENSE">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\..\vs_solutions\logo-knot.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>
 
  <ItemGroup>
    <ProjectReference Include="..\..\..\Data\DataFrame\dataframework-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\Graph\graph-netcore5.vbproj" />
    <ProjectReference Include="..\..\MachineLearning\TensorFlow\TensorFlow.vbproj" />
    <ProjectReference Include="..\..\Mathematica\Math\ANOVA\ANOVA.vbproj" />
    <ProjectReference Include="..\..\Mathematica\Math\Math.Statistics\stats-netcore5.vbproj" />
    <ProjectReference Include="..\..\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\Mathematica\Math\Randomizer\randomizer-netcore5.vbproj" />
    <ProjectReference Include="..\DataMining\DataMining.NET5.vbproj" />
  </ItemGroup>

</Project>

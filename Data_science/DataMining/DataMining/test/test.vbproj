<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Testing</RootNamespace>
    <AssemblyName>Testing</AssemblyName>
    <!-- 非交互 CLI 入口：selftest / bench 子命令 -->
    <StartupObject>Testing.AprioriTest</StartupObject>
    <MyType>Empty</MyType>
    <OptionStrict>Off</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);BC40000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- NumericTableTests 是同目录下的独立工程（含另一个 Main），必须排除 -->
    <Compile Remove="NumericTableTests\**" />
    <!-- 旧式工程遗留的 My Project 模板文件：AssemblyInfo 与 SDK 自动生成的程序集特性冲突，一并剔除 -->
    <Compile Remove="My Project\**" />
    <EmbeddedResource Remove="My Project\**" />
    <None Remove="My Project\**" />
    <Compile Remove="bin\**;obj\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataMining.NET5.vbproj" />
    <ProjectReference Include="..\..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\Mathematica\Math\Math\Math.NET5.vbproj" />
  </ItemGroup>

</Project>

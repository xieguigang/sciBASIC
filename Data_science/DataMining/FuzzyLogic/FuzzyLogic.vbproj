<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.VisualBasic.DataMining.FuzzyLogic</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Microsoft.VisualBasic.DataMining.FuzzyLogic</AssemblyName>
    <Version>10.8.9797.36764</Version>
    <AssemblyVersion>1.0.9797.36764</AssemblyVersion>
    <Configurations>Debug;Release;nuget_release</Configurations>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../../.nuget/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\Mathematica\Math\DataFittings\linear-netcore5.vbproj" />
    <ProjectReference Include="..\..\Mathematica\Math\Math.Statistics\stats-netcore5.vbproj" />
    <ProjectReference Include="..\..\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\DataMining\DataMining.NET5.vbproj" />
  </ItemGroup>

  <!-- 自检程序是独立工程，不能被编进库 -->
  <ItemGroup>
    <Compile Remove="_smoketest\**" />
    <EmbeddedResource Remove="_smoketest\**" />
    <None Remove="_smoketest\**" />
  </ItemGroup>

</Project>

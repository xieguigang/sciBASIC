<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FuzzyLogic.SelfTest</RootNamespace>
    <AssemblyName>FuzzyLogic.SelfTest</AssemblyName>
    <StartupObject>FuzzyLogic.SelfTest.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FuzzyLogic.vbproj" />
  </ItemGroup>

</Project>

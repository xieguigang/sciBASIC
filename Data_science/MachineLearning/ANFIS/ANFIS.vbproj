<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.VisualBasic.DeepLearning.ANFIS</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyTitle>Adaptive Network-based Fuzzy Inference System</AssemblyTitle>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Adaptive Network-based Fuzzy Inference System</Title>
    <AssemblyName>Microsoft.VisualBasic.DeepLearning.ANFIS</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;LipidSearch;Rsharp_app_release;mzkit;mzkit_win32;gcmodeller_desktop;nuget_release;MEMI-Desktop</Configurations>
    <Description>Takagi-Sugeno ANFIS training layer: hybrid least squares / back propagation learning, rule pruning and cross validation on top of the shared differentiable TSK inference kernel (Microsoft.VisualBasic.DataMining.FuzzyLogic).</Description>
    <PackageTags>scibasic;anfis;neuro-fuzzy;fuzzy-logic;takagi-sugeno;machine-learning</PackageTags>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>readme.md</PackageReadmeFile>

    <!-- 数值代码全部走显示类型转换：Double/Single 混用与隐式窄化在本仓出过静默错误 -->
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <Version>10.8.9797.36764</Version>
    <AssemblyVersion>1.0.9797.36764</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../../.nuget/</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Rsharp_app_release|x64'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\DataMining\FuzzyLogic\FuzzyLogic.vbproj" />
  </ItemGroup>

  <!-- 自检程序是独立工程，不能被编进库 -->
  <ItemGroup>
    <Compile Remove="_smoketest\**" />
    <EmbeddedResource Remove="_smoketest\**" />
    <None Remove="_smoketest\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="readme.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>

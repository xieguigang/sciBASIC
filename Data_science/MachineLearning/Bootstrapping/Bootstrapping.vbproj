<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OptionInfer>On</OptionInfer>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(ProjectDir)**\*.cs</DefaultItemExcludes>
    <AssemblyName>Microsoft.VisualBasic.MachineLearning.Bootstrapping</AssemblyName>
    <RootNamespace>Microsoft.VisualBasic.MachineLearning.Bootstrapping</RootNamespace>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Graph and Knowledge Graph Embedding Toolkit (node2vec, graph2vec, ComplEx)</Title>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;Rsharp_app_release;nuget_release</Configurations>
    <Version>1.0.9758.20045</Version>
    <AssemblyVersion>1.0.9758.20045</AssemblyVersion>
    <Description>Provides graph representation learning for sciBASIC#: node2vec biased random walks with word2vec, whole-graph graph2vec vectors, and ComplEx knowledge-graph embedding variants trained by AdaGrad.</Description>
    <AssemblyTitle>Microsoft.VisualBasic.MachineLearning.Bootstrapping</AssemblyTitle>
    <Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
    <Company>sciBASIC.NET Foundation</Company>
    <Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
    <PackageTags>scibasic;graph-embedding;node2vec;graph2vec;knowledge-graph;complex;random-walk;representation-learning</PackageTags>
    <PackageReleaseNotes>Graph and knowledge graph embedding for sciBASIC#. The GraphEmbedding namespace defines the shared embedding abstractions, with GraphEmbedding.complex, complex_NNE, complex_NNE_AER and complex_R implementing the ComplEx knowledge graph embedding variants together with the neural network encoder and auto-encoder regularised forms; GraphEmbedding.struct covers structural embeddings and GraphEmbedding.util the supporting helpers. The node2vec namespace implements the node2vec biased random walk plus word2vec training to produce node vectors, and the root namespace covers whole graph graph2vec style vectors. Together they provide graph representation learning, so a graph can be turned into numeric vectors that the standard machine learning packages can consume - which turns link prediction and node classification into ordinary vector based learning problems.</PackageReleaseNotes>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageIcon>logo-knot.png</PackageIcon>
    <PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../../.nuget/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\nlp\word2vec\word2vec.vbproj" />
    <ProjectReference Include="..\..\Graph\graph-netcore5.vbproj" />
    <ProjectReference Include="..\..\Mathematica\Math\Math\Math.NET5.vbproj" />
    <None Include="..\..\..\vs_solutions\logo-knot.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>
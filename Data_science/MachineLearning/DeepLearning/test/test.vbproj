<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>test</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <Version>1.0.9753.4776</Version>
    <AssemblyVersion>1.0.9753.4776</AssemblyVersion>
    <StartupObject>test.MnistTest</StartupObject>
    <!-- ILCuda / ILCudaTensor 强制 x64，本工程必须同为 x64，否则会出现 MSB3270 架构不匹配 -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Data\BinaryData\BinaryData\binarydata-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\Data\BinaryData\HDSPack\HDSPack.vbproj" />
    <ProjectReference Include="..\..\..\..\Data\BinaryData\msgpack\msgpack-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\Data\BinaryData\netCDF\netCDF.vbproj" />
    <ProjectReference Include="..\..\..\..\Data\DataFrame\dataframework-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\DataMining\DataMining\DataMining.NET5.vbproj" />
    <ProjectReference Include="..\..\..\Mathematica\Math\DataFrame\dataframeUtils-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\Mathematica\Math\Math.Statistics\stats-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\LNN\LNN.vbproj" />
    <ProjectReference Include="..\..\MachineLearning\machine_learning-netcore5.vbproj" />
    <ProjectReference Include="..\..\MLDataStorage\MLDataStorage.vbproj" />
    <ProjectReference Include="..\..\TensorFlow\TensorFlow.vbproj" />
    <ProjectReference Include="..\DeepLearning.NET6.vbproj" />
    <!-- GPU 后端：ILCudaTensor 提供 CudaTensor，ILCuda 提供 NVRTC/驱动 API 与内核编译单元 -->
    <ProjectReference Include="..\..\..\..\cuda\ILCuda\ILCuda.vbproj" />
    <ProjectReference Include="..\..\..\..\cuda\ILCudaTensor\ILCudaTensor.vbproj" />
  </ItemGroup>

</Project>

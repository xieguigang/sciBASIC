<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OptionInfer>On</OptionInfer>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>17.13</LangVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(ProjectDir)**\*.cs</DefaultItemExcludes>
    <Platforms>AnyCPU;x64</Platforms>
    <AssemblyName>Microsoft.VisualBasic.DeepLearning.GNN</AssemblyName>
    <RootNamespace>Microsoft.VisualBasic.DeepLearning.GNN</RootNamespace>
    <Version>1.0.9742.7537</Version>
    <AssemblyVersion>1.0.9742.7537</AssemblyVersion>
    <Configurations>nuget_release;Rsharp_app_release</Configurations>
    <Title>Graph Neural Networks: GCN, GAT and Recurrent Temporal Graph Layers</Title>
    <Description>Graph neural network library for sciBASIC#, providing GCN and graph-attention layers, GRU and RNN recurrent graph layers, temporal graph snapshots, and graph classification models with SGD and Adam training.</Description>
    <AssemblyTitle>Microsoft.VisualBasic.DeepLearning.GNN</AssemblyTitle>
    <Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
    <Company>sciBASIC.NET Foundation</Company>
    <Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
    <PackageTags>scibasic;graph-neural-network;gcn;graph-attention;temporal-graph</PackageTags>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageIcon>logo-knot.png</PackageIcon>
    <PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../../.nuget/</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Rsharp_app_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../../.nuget/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="test\**" />
    <EmbeddedResource Remove="test\**" />
    <None Remove="test\**" />
    <None Include="..\..\..\vs_solutions\logo-knot.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\TensorFlow\TensorFlow.vbproj" />
  </ItemGroup>
</Project>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.VisualBasic.MachineLearning.VariationalAutoencoder</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>Microsoft.VisualBasic.MachineLearning.VAE</AssemblyName>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Variational Autoencoders: Graph VAE, Gaussian Mixture VAE and GMM</Title>
    <Description>Generative modelling library for sciBASIC#: a graph variational autoencoder with GCN encoder and inner-product decoder, a Gaussian mixture VAE with categorical latents, and an EM-trained Gaussian mixture model.</Description>
    <Configurations>Debug;Release;LipidSearch;Rsharp_app_release;mzkit;mzkit_win32;gcmodeller_desktop;nuget_release</Configurations>
    <Platforms>AnyCPU;x64</Platforms>
    <PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>1.0.9762.10518</Version>
    <AssemblyVersion>1.0.9762.10518</AssemblyVersion>
    <AssemblyTitle>Microsoft.VisualBasic.MachineLearning.VAE</AssemblyTitle>
    <Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
    <Company>sciBASIC.NET Foundation</Company>
    <Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
    <PackageTags>scibasic;variational-autoencoder;graph-vae;gaussian-mixture;gmm;generative-model;latent-space;clustering</PackageTags>
    <PackageReleaseNotes>Variational autoencoders and Gaussian mixture models for sciBASIC#. The GraphVAE type implements a graph variational autoencoder - a graph convolutional network encoder paired with an inner product decoder - so graphs can be embedded into a continuous latent space and sampled from it. The Gaussian mixture VAE uses categorical latent variables, which makes the latent space directly interpretable as a soft cluster assignment rather than an opaque code. The package also provides an EM trained Gaussian mixture model, and MathUtils supplies the numerical helpers (log-sum-exp, KL divergence and sampling utilities) needed by all of them. The result is a generative modelling layer that doubles as a soft clustering method.</PackageReleaseNotes>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageIcon>logo-knot.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <RemoveIntegerChecks>true</RemoveIntegerChecks>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <OutputPath>../../../.nuget/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="test\**" />
    <EmbeddedResource Remove="test\**" />
    <None Remove="test\**" />
    <None Include="..\..\..\vs_solutions\logo-knot.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\DataMining\DataMining\DataMining.NET5.vbproj" />
    <ProjectReference Include="..\..\Mathematica\Math\Math.Statistics\stats-netcore5.vbproj" />
    <ProjectReference Include="..\..\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\DeepLearning\DeepLearning.NET6.vbproj" />
    <ProjectReference Include="..\MachineLearning\machine_learning-netcore5.vbproj" />
    <ProjectReference Include="..\TensorFlow\TensorFlow.vbproj" />
  </ItemGroup>

</Project>

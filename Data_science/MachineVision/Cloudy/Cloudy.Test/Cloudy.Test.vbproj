<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Microsoft.VisualBasic.MachineVision.Cloudy.Test</RootNamespace>
    <AssemblyName>Cloudy.Test</AssemblyName>
    <AssemblyTitle>Point cloud algorithm verification</AssemblyTitle>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);BC42024;BC42104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cloudy.vbproj" />
    <ProjectReference Include="..\..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
  </ItemGroup>

</Project>

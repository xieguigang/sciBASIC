<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 源码里已经显式 Namespace UNet，若这里再给 RootNamespace 赋值，VB 会把它**前缀**到
         声明的命名空间之前（得到 UNet.UNet），因此这里必须留空。 -->
    <RootNamespace>Microsoft.VisualBasic.MachineVision.UNet</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <AssemblyName>Microsoft.VisualBasic.MachineVision.UNet</AssemblyName>
    <AssemblyTitle>Microsoft.VisualBasic.MachineVision.UNet</AssemblyTitle>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>U-Net: Convolutional Networks for Biomedical Image Segmentation</Title>
    <Configurations>Debug;Release;nuget_release</Configurations>
    <Version>10.8.9818.14504</Version>
    <AssemblyVersion>1.0.9818.14504</AssemblyVersion>
    <Description>A U-Net semantic segmentation model built on the sciBASIC# CNN layers: symmetric encoder-decoder with skip connections, mini-batch Adam / SGD training, DSB2018 dataset loading and RLE mask codec, and IoU / Dice evaluation metrics.</Description>
    <Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
    <Company>sciBASIC.NET Foundation</Company>
    <Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
    <PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>scibasic;unet;image-segmentation;deep-learning;cnn;biomedical</PackageTags>
    <PackageReleaseNotes>This cycle: Cnfig project msbuild output; Fixed the png library reference; Fixed the namespace reference error.</PackageReleaseNotes>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageIcon>logo-knot.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../../.nuget/</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Rsharp_app_release|x64'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="test\**" />
    <EmbeddedResource Remove="test\**" />
    <None Remove="test\**" />
    <None Include="..\..\..\vs_solutions\logo-knot.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\vs_solutions\dev\VisualStudio\VisualStudio.NET5.vbproj" />
    <ProjectReference Include="..\..\DataMining\DataMining\DataMining.NET5.vbproj" />
    <ProjectReference Include="..\..\MachineLearning\DeepLearning\DeepLearning.NET6.vbproj" />
    <ProjectReference Include="..\..\MachineLearning\MachineLearning\machine_learning-netcore5.vbproj" />
    <ProjectReference Include="..\..\MachineLearning\TensorFlow\TensorFlow.vbproj" />
    <ProjectReference Include="..\..\Mathematica\Math\Math\Math.NET5.vbproj" />
  </ItemGroup>

</Project>

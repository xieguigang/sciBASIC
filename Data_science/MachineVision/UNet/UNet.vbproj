<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 源码里已经显式 Namespace UNet，若这里再给 RootNamespace 赋值，VB 会把它**前缀**到
         声明的命名空间之前（得到 UNet.UNet），因此这里必须留空。 -->
    <RootNamespace>Microsoft.VisualBasic.MachineVision.UNet</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <AssemblyName>Microsoft.VisualBasic.MachineVision.UNet</AssemblyName>
    <AssemblyTitle>U-Net: Convolutional Networks for Biomedical Image Segmentation</AssemblyTitle>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>U-Net: Convolutional Networks for Biomedical Image Segmentation</Title>
    <Configurations>Debug;Release;nuget_release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="test\**" />
    <EmbeddedResource Remove="test\**" />
    <None Remove="test\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\vs_solutions\dev\VisualStudio\VisualStudio.NET5.vbproj" />
    <ProjectReference Include="..\..\DataMining\DataMining\DataMining.NET5.vbproj" />
    <ProjectReference Include="..\..\MachineLearning\DeepLearning\DeepLearning.NET6.vbproj" />
    <ProjectReference Include="..\..\MachineLearning\MachineLearning\machine_learning-netcore5.vbproj" />
    <ProjectReference Include="..\..\MachineLearning\TensorFlow\TensorFlow.vbproj" />
    <ProjectReference Include="..\..\Mathematica\Math\Math\Math.NET5.vbproj" />
  </ItemGroup>

</Project>

' ---------------------------------------------------------------------------
' Cloudy 点云 ↔ ASCII PLY
'
' 为什么不用 Landscape 的 PlyWriter：
'   Landscape 的 PLY 写入器只覆盖点云且属性布局固定；这里需要在
'   “高斯表面点云（含 opacity/scale）”和“重建用点云（含法向/颜色）”两种
'   布局之间切换，并且要被 Cloudy 直接消费，因此用一个自包含的实现，
'   读取时按 PLY 头部声明的属性顺序解析，避免写死列号。
' ---------------------------------------------------------------------------

Imports System.IO
Imports System.Text
Imports CC = Microsoft.VisualBasic.MachineVision.Cloudy.Core
Imports std = System.Math

Namespace Io

    ''' <summary>
    ''' 供 Cloudy 消费的 ASCII PLY 读写。
    ''' </summary>
    Public NotInheritable Class CloudPly

        Private Sub New()
        End Sub

        ''' <summary>
        ''' 写“高斯表面点云”：位置 + 颜色 + 不透明度 + 尺度。
        ''' </summary>
        Public Shared Sub SaveSurface(path As String,
                                      x As Double(), y As Double(), z As Double(),
                                      red As Double(), green As Double(), blue As Double(),
                                      opacity As Double(), scale As Double())
            Dim count As Integer = x.Length

            Using writer As New StreamWriter(path, False, New UTF8Encoding(False))
                Call writer.WriteLine("ply")
                Call writer.WriteLine("format ascii 1.0")
                Call writer.WriteLine($"comment 3D gaussian splatting surface cloud, generated by WorldMaker")
                Call writer.WriteLine($"element vertex {count}")
                Call writer.WriteLine("property float x")
                Call writer.WriteLine("property float y")
                Call writer.WriteLine("property float z")
                Call writer.WriteLine("property uchar red")
                Call writer.WriteLine("property uchar green")
                Call writer.WriteLine("property uchar blue")
                Call writer.WriteLine("property float opacity")
                Call writer.WriteLine("property float scale")
                Call writer.WriteLine("end_header")

                For i As Integer = 0 To count - 1
                    ' 高斯颜色是 0..1 的归一化值，PLY 的 uchar 通道要 0..255
                    Call writer.WriteLine($"{x(i):F6} {y(i):F6} {z(i):F6} " &
                                          $"{ToByte255(red(i))} {ToByte255(green(i))} {ToByte255(blue(i))} " &
                                          $"{opacity(i):F4} {scale(i):F6}")
                Next
            End Using
        End Sub

        ''' <summary>
        ''' 读取 PLY（ASCII）为 Cloudy 点云；自动识别 x/y/z、nx/ny/nz、red/green/blue、intensity。
        ''' </summary>
        Public Shared Function Load(path As String) As CC.PointCloudBuffer
            Using reader As New StreamReader(path, Encoding.UTF8)
                Dim first As String = reader.ReadLine()

                If first Is Nothing OrElse Not first.Trim().Equals("ply", StringComparison.OrdinalIgnoreCase) Then
                    Throw New InvalidDataException($"不是合法的 PLY 文件: {path}")
                End If

                Dim format As String = ""
                Dim vertexCount As Integer = 0
                Dim properties As New List(Of String)()
                Dim inVertexElement As Boolean = False

                While True
                    Dim line As String = reader.ReadLine()

                    If line Is Nothing Then
                        Throw New InvalidDataException($"PLY 头部不完整（缺少 end_header）: {path}")
                    End If

                    line = line.Trim()

                    If line.Length = 0 Then Continue While
                    If line.StartsWith("comment") Then Continue While

                    If line.StartsWith("format") Then
                        format = line
                        Continue While
                    End If

                    If line.StartsWith("element") Then
                        Dim parts As String() = line.Split({" "c}, StringSplitOptions.RemoveEmptyEntries)

                        inVertexElement = parts.Length >= 3 AndAlso parts(1).Equals("vertex", StringComparison.OrdinalIgnoreCase)

                        If inVertexElement Then
                            vertexCount = Integer.Parse(parts(2))
                        End If

                        Continue While
                    End If

                    If line.StartsWith("property") Then
                        If inVertexElement Then
                            Dim parts As String() = line.Split({" "c}, StringSplitOptions.RemoveEmptyEntries)

                            ' property <type> <name>
                            If parts.Length >= 3 Then Call properties.Add(parts(parts.Length - 1))
                        End If

                        Continue While
                    End If

                    If line.StartsWith("end_header") Then Exit While
                End While

                If Not String.IsNullOrEmpty(format) AndAlso Not format.Contains("ascii") Then
                    Throw New NotSupportedException($"只支持 ASCII PLY（当前: {format}）")
                End If

                Dim cloud As CC.PointCloudBuffer = CC.PointCloudBuffer.NewCloud(vertexCount)
                Dim nx(vertexCount - 1) As Double
                Dim ny(vertexCount - 1) As Double
                Dim nz(vertexCount - 1) As Double
                Dim color(vertexCount - 1) As Integer

                Dim hasNormal As Boolean = properties.Contains("nx") AndAlso properties.Contains("ny") AndAlso properties.Contains("nz")
                Dim hasColor As Boolean = properties.Contains("red")

                For i As Integer = 0 To vertexCount - 1
                    Dim line As String = reader.ReadLine()

                    If line Is Nothing Then
                        Throw New InvalidDataException($"PLY 顶点数据不完整: 期望 {vertexCount} 个点，在第 {i} 行中断")
                    End If

                    Dim fields As String() = line.Split({" "c, vbTab}, StringSplitOptions.RemoveEmptyEntries)

                    For p As Integer = 0 To properties.Count - 1
                        Dim valueText As String = If(p < fields.Length, fields(p), "0")
                        Dim name As String = properties(p)

                        Select Case name
                            Case "x"
                                cloud.X(i) = ParseDouble(valueText)
                            Case "y"
                                cloud.Y(i) = ParseDouble(valueText)
                            Case "z"
                                cloud.Z(i) = ParseDouble(valueText)
                            Case "nx"
                                nx(i) = ParseDouble(valueText)
                            Case "ny"
                                ny(i) = ParseDouble(valueText)
                            Case "nz"
                                nz(i) = ParseDouble(valueText)
                            Case "red"
                                color(i) = MakeArgb(ToByte(ParseDouble(valueText)), 0, 0)
                            Case "green"
                                color(i) = color(i) Or (ToByte(ParseDouble(valueText)) << 8)
                            Case "blue"
                                ' ARGB 布局：R 在高字节、G 次之、B 在最低字节
                                color(i) = color(i) Or ToByte(ParseDouble(valueText))
                        End Select
                    Next
                Next

                If hasColor Then
                    For i As Integer = 0 To vertexCount - 1
                        color(i) = color(i) Or &HFF000000
                    Next

                    cloud.Color = color
                End If

                If hasNormal Then
                    cloud.SetNormals(nx, ny, nz)
                End If

                Return cloud
            End Using
        End Function

        ''' <summary>
        ''' 写一个不带颜色的点云（便于把中间结果落到磁盘复查）。
        ''' </summary>
        Public Shared Sub SaveCloud(path As String, cloud As CC.PointCloudBuffer)
            Using writer As New StreamWriter(path, False, New UTF8Encoding(False))
                Call writer.WriteLine("ply")
                Call writer.WriteLine("format ascii 1.0")
                Call writer.WriteLine($"element vertex {cloud.Count}")
                Call writer.WriteLine("property float x")
                Call writer.WriteLine("property float y")
                Call writer.WriteLine("property float z")

                If cloud.HasNormals Then
                    Call writer.WriteLine("property float nx")
                    Call writer.WriteLine("property float ny")
                    Call writer.WriteLine("property float nz")
                End If

                If cloud.Color IsNot Nothing Then
                    Call writer.WriteLine("property uchar red")
                    Call writer.WriteLine("property uchar green")
                    Call writer.WriteLine("property uchar blue")
                End If

                Call writer.WriteLine("end_header")

                For i As Integer = 0 To cloud.Count - 1
                    Dim sb As New StringBuilder()

                    Call sb.Append($"{cloud.X(i):F6} {cloud.Y(i):F6} {cloud.Z(i):F6}")

                    If cloud.HasNormals Then
                        Call sb.Append($" {cloud.Nx(i):F6} {cloud.Ny(i):F6} {cloud.Nz(i):F6}")
                    End If

                    If cloud.Color IsNot Nothing Then
                        Dim argb As Integer = cloud.Color(i)

                        Call sb.Append($" {(argb >> 16) And 255} {(argb >> 8) And 255} {argb And 255}")
                    End If

                    Call writer.WriteLine(sb.ToString())
                Next
            End Using
        End Sub

        Private Shared Function MakeArgb(r As Integer, g As Integer, b As Integer) As Integer
            Return (r << 16) Or (g << 8) Or b
        End Function

        Private Shared Function ToByte(value As Double) As Integer
            If Double.IsNaN(value) Then Return 0

            Return CInt(std.Max(0.0, std.Min(255.0, value)))
        End Function

        ''' <summary>把 0..1 的归一化颜色分量转成 0..255。</summary>
        Private Shared Function ToByte255(value As Double) As Integer
            If Double.IsNaN(value) Then Return 0

            Return CInt(std.Max(0.0, std.Min(255.0, value * 255.0)))
        End Function

        Private Shared Function ParseDouble(text As String) As Double
            Dim value As Double

            If Double.TryParse(text, System.Globalization.NumberStyles.Float,
                               System.Globalization.CultureInfo.InvariantCulture, value) Then
                Return value
            End If

            Return 0.0
        End Function

    End Class

End Namespace

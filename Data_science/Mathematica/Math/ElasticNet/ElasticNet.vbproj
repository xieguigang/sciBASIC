<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.VisualBasic.Data.Bootstrapping.ElasticNet</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Microsoft.VisualBasic.Data.Bootstrapping.ElasticNet</AssemblyName>
    <AssemblyTitle>Regularization and Variable Selection via the Elastic Net</AssemblyTitle>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>Regularization and Variable Selection via the Elastic Net</Title>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- 自检工程是独立的控制台程序，不能被主库的默认 glob 编译进来 -->
    <Compile Remove="_smoketest\**" />
    <EmbeddedResource Remove="_smoketest\**" />
    <None Remove="_smoketest\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\DataFittings\linear-netcore5.vbproj" />
    <ProjectReference Include="..\Math\Math.NET5.vbproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.VisualBasic.Data.Bootstrapping.ElasticNet</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Microsoft.VisualBasic.Data.Bootstrapping.ElasticNet</AssemblyName>
    <AssemblyTitle>Microsoft.VisualBasic.Data.Bootstrapping.ElasticNet</AssemblyTitle>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>Regularization and Variable Selection via the Elastic Net</Title>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;Rsharp_app_release;nuget_release</Configurations>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Version>10.8.0.0</Version>
    <AssemblyVersion>1.0.9797.36730</AssemblyVersion>
    <Description>Elastic net regression for sciBASIC#: a coordinate-descent solver that combines L1 and L2 penalties with an unpenalized intercept, warm-started regularization paths, cross validation over the l1Ratio and alpha grid, a polynomial view of the fitted model and NumericTable entry points for table based workflows.</Description>
    <Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
    <Company>sciBASIC.NET Foundation</Company>
    <Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
    <PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>scibasic;elastic-net;regularization;lasso;ridge;coordinate-descent;cross-validation;feature-selection</PackageTags>
    <PackageReleaseNotes>Initial release: coordinate-descent elastic net fitting, alpha regularization paths with warm starts, cross validation over the l1Ratio and alpha grid, polynomial model view and NumericTable regression entry points.</PackageReleaseNotes>
    <PackageIcon>logo-knot.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../../../.nuget/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- 自检工程是独立的控制台程序，不能被主库的默认 glob 编译进来 -->
    <Compile Remove="_smoketest\**" />
    <EmbeddedResource Remove="_smoketest\**" />
    <None Remove="_smoketest\**" />
    <None Include="..\..\..\..\vs_solutions\logo-knot.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\DataFittings\linear-netcore5.vbproj" />
    <ProjectReference Include="..\Math\Math.NET5.vbproj" />
  </ItemGroup>

</Project>

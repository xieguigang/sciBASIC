<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OptionInfer>On</OptionInfer>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(ProjectDir)**\*.cs</DefaultItemExcludes>
    <AssemblyName>Microsoft.VisualBasic.Math.Symbolic.GeneticProgramming</AssemblyName>
    <RootNamespace>Microsoft.VisualBasic.Math.Symbolic.GeneticProgramming</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Symbolic Regression via Genetic Programming and GA</Title>
    <Configurations>Debug;Release;Rsharp_app_release;nuget_release</Configurations>
    <Version>1.0.9758.20045</Version>
    <AssemblyVersion>1.0.9758.20045</AssemblyVersion>
    <Description>Evolves mathematical expressions and polynomial models with genetic programming and genetic algorithms, using pluggable expression trees and error objectives such as MSE, MAE, SSE and SAE. Part of sciBASIC#.</Description>
    <AssemblyTitle>Microsoft.VisualBasic.Math.Symbolic.GeneticProgramming</AssemblyTitle>
    <Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
    <Company>sciBASIC.NET Foundation</Company>
    <Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
    <PackageTags>scibasic;genetic-programming;symbolic-regression;expression-tree;evolutionary-algorithm;polynomial-model;fitness-function</PackageTags>
    <PackageReleaseNotes>Symbolic regression via genetic programming for sciBASIC#. The evolution namespace implements the evolution engine over pluggable expression trees, and the measure namespace provides the error objectives (MSE, MAE, SSE and SAE) used to rank candidate expressions; the model namespace defines the symbolic expression model, model.factory builds the initial expressions and model.impl provides the concrete node implementations. The result is a symbolic expression or polynomial model that fits the data, rather than a black box predictor - which makes the outcome inspectable, differentiable and directly usable inside other mathematical code. It is the interpretable counterpart of the regression models in the DataFittings package.</PackageReleaseNotes>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageIcon>logo-knot.png</PackageIcon>
    <PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../../../.nuget/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="test\**" />
    <EmbeddedResource Remove="test\**" />
    <None Remove="test\**" />
    <None Include="..\..\..\..\vs_solutions\logo-knot.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\..\mime\application%xml\xml-netcore5.vbproj" />
    <ProjectReference Include="..\DataFittings\linear-netcore5.vbproj" />
    <ProjectReference Include="..\MathLambda\symbolic-netcore5.vbproj" />
    <ProjectReference Include="..\Math\Math.NET5.vbproj" />
  </ItemGroup>
</Project>
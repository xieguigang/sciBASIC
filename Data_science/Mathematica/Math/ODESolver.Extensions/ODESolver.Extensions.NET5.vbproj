<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>Microsoft.VisualBasic.Math.Calculus</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
		<AssemblyName>Microsoft.VisualBasic.Math.ODEsSolver.Extensions</AssemblyName>
		<Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
		<Company>sciBASIC.NET Foundation</Company>
		<Version>5.0.9762.10518</Version>
		<Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
		<PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
		<PackageIcon>logo-knot.png</PackageIcon>
		<RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
		<Platforms>AnyCPU;x64</Platforms>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Description>Extension helpers that turn ODE integration output into data frames and CSV files, reload them, and compute Pearson or Spearman correlations between the modelled variables. Part of sciBASIC#.</Description>
		<Configurations>Debug;Release;Rsharp_app_release;LipidSearch;mzkit;nuget_release</Configurations>
		<RepositoryType>git</RepositoryType>
		<AssemblyVersion>1.0.9762.10518</AssemblyVersion>
		<Title>ODE Solver Extensions: Result Export and Correlation Analysis</Title>
		<AssemblyTitle>Microsoft.VisualBasic.Math.ODEsSolver.Extensions</AssemblyTitle>
		<PackageTags>scibasic;ode-solver;data-frame;correlation;pearson;spearman;csv-export</PackageTags>
    <PackageReleaseNotes>Extension helpers for the ODE solver stack of sciBASIC#. They turn the raw integration output into analysis ready artefacts: the per step variable values are exported as a data frame and as CSV files, the same files can be reloaded back into a data frame, and Pearson or Spearman correlations between the modelled variables are computed directly over the integration result. This closes the loop between simulation and analysis - a dynamic model can be integrated, exported, re-loaded, statistically compared and finally plotted with the charting packages, without writing any glue code.</PackageReleaseNotes>
		<PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
	  <OutputPath>bin\x64\</OutputPath>
	  <RemoveIntegerChecks>true</RemoveIntegerChecks>
	  <DebugSymbols>true</DebugSymbols>
	  <DebugType>full</DebugType>
	  <DocumentationFile>Microsoft.VisualBasic.Math.ODEsSolver.Extensions.xml</DocumentationFile>
	  <DefineConstants>netcore5=1</DefineConstants>
	  <BaseAddress>4194304</BaseAddress>
	</PropertyGroup>


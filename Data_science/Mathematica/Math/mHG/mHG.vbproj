<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
   
    <OutputType>Library</OutputType>
   <Configurations>Debug;Release;LipidSearch;Rsharp_app_release;mzkit;mzkit_win32;gcmodeller_desktop;nuget_release</Configurations>
    <RootNamespace>Microsoft.VisualBasic.Math.Statistics.Hypothesis.mHG</RootNamespace>
    <AssemblyName>Microsoft.VisualBasic.Math.Statistics.Hypothesis.mHG</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <TargetFramework>net10.0</TargetFramework>
    <UseApplicationFramework>True</UseApplicationFramework>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <AssemblyTitle>Microsoft.VisualBasic.Math.Statistics.Hypothesis.mHG</AssemblyTitle>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>

    <Title>Minimum Hypergeometric (mHG) Test for Ranked List Enrichment</Title>
    <Description>A minimum hypergeometric (mHG) testing toolkit for sciBASIC#: computes the optimal prefix cutoff, the mHG statistic and its exact p-value over ranked lists, with dynamic programming hypergeometric row calculations for gene set and feature enrichment studies.</Description>
    <PackageTags>scibasic;hypothesis-testing;minimum-hypergeometric;enrichment;ranked-list;gene-set</PackageTags>
    <PackageReleaseNotes>Package maintenance release: build and packaging configuration updates only, no functional changes in this cycle.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>10.7.9791.26955</Version>
    <AssemblyVersion>1.0.9791.26955</AssemblyVersion>
    <Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
    <Company>sciBASIC.NET Foundation</Company>
    <Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
    <PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageIcon>logo-knot.png</PackageIcon>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../../../.nuget/</OutputPath>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="test\**" />
	  <EmbeddedResource Remove="test\**" />
	  <None Remove="test\**" />
	  <None Include="..\..\..\..\vs_solutions\logo-knot.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <None Include="README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
	  <ProjectReference Include="..\Math\Math.NET5.vbproj" />
	</ItemGroup>
  
</Project>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.VisualBasic.Data.Plots</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <Version>1.0.9775.28485</Version>
    <AssemblyVersion>1.0.9775.28485</AssemblyVersion>
    <AssemblyName>Microsoft.VisualBasic.Data.DataPlot</AssemblyName>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <OutputPath>../../../.nuget</OutputPath>
    <Configurations>Debug;Release;nuget_release;Rsharp_app_release</Configurations>
    <Title>DataPlot: GDI+ Chart Engine with ggplot2-Style Theme Units</Title>
    <Description>Standalone GDI+ charting engine for sciBASIC#: scatter (bubble/error-bar/jitter/hull), line, area, bar (grouped/stacked/percent/diverging/color-scale), histogram, box, violin, jitter, pie, radar, rose, pyramid, venn, contour, density, heatmap, cluster heatmap, correlation matrix, bubble heatmap, z-score, ROC, QQ, forest, PCA, Manhattan, regression, time trends and treemap plots rendered onto a bitmap with ggplot2-style theme units and automatic pixel layout.</Description>
    <AssemblyTitle>Microsoft.VisualBasic.Data.DataPlot</AssemblyTitle>
    <Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
    <Company>sciBASIC.NET Foundation</Company>
    <Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
    <PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>scibasic;dataplot;chart;plotting;gdi-plus;ggplot-theme;data-visualization;boxplot;violin-plot;heatmap;sankey;treemap;contour;venn;roc-curve;qq-plot;forest-plot;pca-plot;manhattan-plot;correlation-matrix</PackageTags>
    <PackageReleaseNotes>DataPlot is the standalone GDI+ charting engine for sciBASIC# and now hosts all 2D plotting capabilities migrated from the legacy Plots and Plots-statistics packages: the bar family (grouped, stacked, percent, diverging, horizontal, color-scale) is one parameterized plot; the scatter family gains bubble sizing, error bars, spline smoothing, convex hulls and jitter; new charts include contour/heatmap surfaces, venn diagrams, population pyramids, 2D density plots, cluster and correlation heatmaps, tree-plus-stacked-bar, ROC, QQ, forest, scree and PCA score plots with confidence ellipses, regression fits, Manhattan plots, mirrored bi-histograms, time trends, variable-width bars and z-score matrices. Statistical algorithm results (clustering trees, regression fits, PCA scores, correlation matrices) are injected through lightweight data contracts, so the package keeps its minimal dependency set - ggplot2 style theme units, automatic pixel layout and strong-typed themes remain the visual foundation.</PackageReleaseNotes>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageIcon>logo-knot.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../../.nuget/</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Rsharp_app_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../../.nuget/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="test\**" />
    <EmbeddedResource Remove="test\**" />
    <None Remove="test\**" />
    <None Include="..\..\..\vs_solutions\logo-knot.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\gr\Microsoft.VisualBasic.Imaging\imaging.NET5.vbproj" />
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\..\mime\text%html\html_netcore5.vbproj" />
    <ProjectReference Include="..\..\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\DataMining\DataMining\DataMining.NET5.vbproj" />
    <ProjectReference Include="..\..\DataMining\hierarchical-clustering\hierarchical-clustering\hctree.NET5.vbproj" />
    <ProjectReference Include="..\..\Graph\graph-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\Data\DataFrame\dataframework-netcore5.vbproj" />
  </ItemGroup>

</Project>

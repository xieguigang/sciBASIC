Imports Microsoft.VisualBasic.Imaging.BitmapImage.Png

Namespace PngSelfTest

    ''' <summary>
    ''' The self test of the png image codec: the known answer vectors, the 
    ''' encode/decode round trip and the error handling.
    ''' </summary>
    Module PngSelfTest

        Private failures As Integer = 0

        ''' <summary>
        ''' run all of the png image codec checks
        ''' </summary>
        ''' <returns>the number of the failed checks.</returns>
        Function Run() As Integer
            failures = 0

            Call Console.WriteLine()
            Call Console.WriteLine("-- png image codec --")

            Call TestKnownVectors()
            Call TestRoundTrip()
            Call TestGrayScale()
            Call TestErrorHandling()

            Return failures
        End Function

        ''' <summary>
        ''' the png images that are generated by an independent png encoder, 
        ''' the decoder of this runtime should decode them into exactly the same 
        ''' pixel buffer.
        ''' </summary>
        Private Sub TestKnownVectors()
            Call Section("known answer vectors")

            Dim typeName As String() = {"gray", "?", "rgb", "palette", "gray+alpha", "?", "rgba"}

            For Each sample As PngTestData.Vector In PngTestData.Vectors.All
                Dim data As Byte() = Convert.FromBase64String(sample.Data)
                Dim image As PngImage

                Try
                    image = PngReader.Decode(data, verifyCrc:=True, expandTransparency:=sample.ExpandTrns)
                Catch ex As Exception
                    failures += 1
                    Call Console.WriteLine($"   [FAIL] [{sample.Name}] {ex.GetType.Name}: {ex.Message}")
                    Continue For
                End Try

                Dim ok As Boolean = image.Width = sample.Width AndAlso
                                    image.Height = sample.Height AndAlso
                                    image.Channels = sample.Channels AndAlso
                                    image.BitDepth = sample.BitDepth AndAlso
                                    image.ColorType = sample.ColorType AndAlso
                                    image.Interlace = sample.Interlace

                Call Check(ok, $"[{sample.Name}] {image.Width}x{image.Height}, {image.BitDepth} bit, " &
                               $"color type {image.ColorType} ({typeName(image.ColorType)}), " &
                               $"{image.Channels} channel(s), interlace {image.Interlace}")

                Dim expected As Byte() = FromHex(sample.Pixels)
                Dim same As Boolean = SameBytes(expected, image.Pixels)

                If Not same Then
                    Call Console.WriteLine($"   [FAIL] [{sample.Name}] the decoded pixels are mismatched at {FirstDiff(expected, image.Pixels)}")
                    failures += 1
                End If
            Next

            ' the CRC32 checksum of the "123456789" literal
            Dim crc As UInteger = PngCodec.Crc32(System.Text.Encoding.ASCII.GetBytes("123456789"))

            Call Check(crc = &HCBF43926UI, $"the CRC32 of ""123456789"" = &H{crc.ToString("X8")}")
        End Sub

        ''' <summary>
        ''' the image that is written by the encoder of this runtime should be 
        ''' decoded back into exactly the same pixel buffer.
        ''' </summary>
        Private Sub TestRoundTrip()
            Call Section("encode / decode round trip")

            Dim w As Integer = 16
            Dim h As Integer = 16
            Dim dir As String = IO.Path.Combine(IO.Path.GetTempPath(), "png_self_test")

            If Not IO.Directory.Exists(dir) Then
                Call IO.Directory.CreateDirectory(dir)
            End If

            For Each channels As Integer In New Integer() {1, 2, 3, 4}
                Dim pixels As Byte() = MakePixels(w, h, channels)
                Dim file As String = IO.Path.Combine(dir, $"{ColorTypeOf(channels)}_{w}x{h}.png")

                Call PngWriter.Save(file, pixels, w, h, channels)

                Dim image As PngImage = PngReader.Load(file)

                Call Check(image.Width = w AndAlso image.Height = h AndAlso image.Channels = channels,
                           $"{w}x{h}x{channels} -> {image.Width}x{image.Height}x{image.Channels}, {New IO.FileInfo(file).Length} bytes")
                Call Check(SameBytes(pixels, image.Pixels), $"{w}x{h}x{channels} the pixels are identical")
            Next

            ' the raw adaptive filter should be smaller than the unfiltered storage
            Dim rgb As Byte() = MakePixels(w, h, 3)
            Dim adaptive As Integer = PngWriter.Encode(w, h, rgb, 3).Length
            Dim raw As Integer = PngWriter.Encode(w, h, rgb, 3, PngFilterType.None).Length

            Call Check(adaptive <= raw, $"the adaptive row filter is not worse than the unfiltered storage: {adaptive} <= {raw} bytes")

            ' the stream based api
            Using buffer As New IO.MemoryStream()
                Call PngWriter.Save(buffer, rgb, w, h, 3)
                Call buffer.Seek(0, IO.SeekOrigin.Begin)

                Dim image As PngImage = PngReader.Load(buffer)

                Call Check(image.Channels = 3 AndAlso SameBytes(rgb, image.Pixels), "the pixel buffer survives the stream based api")
            End Using

            ' the rgb view of the gray scale image
            Dim gray As Byte() = MakePixels(w, h, 1)

            Using buffer As New IO.MemoryStream()
                Call PngWriter.Save(buffer, gray, w, h, 1)
                Call buffer.Seek(0, IO.SeekOrigin.Begin)

                Dim image As PngImage = PngReader.Load(buffer)

                Call Check(image.Rgb.Length = w * h * 3, $"the rgb view of a gray scale image = {image.Rgb.Length} bytes")
            End Using
        End Sub

        ''' <summary>
        ''' the gray scale api of the UNet style: the normalized pixels are 
        ''' written as a 8 bits gray scale png image and decoded back within the 
        ''' 8 bits quantization error.
        ''' </summary>
        Private Sub TestGrayScale()
            Call Section("the gray scale image io")

            Dim w As Integer = 16
            Dim h As Integer = 16
            Dim pixels As Double() = New Double(w * h - 1) {}
            Dim file As String = IO.Path.Combine(IO.Path.GetTempPath(), "png_self_test", "gray.png")

            For y As Integer = 0 To h - 1
                For x As Integer = 0 To w - 1
                    ' the half of the 8 bits quantization step is added into the 
                    ' source value so that the round trip is not a trivial one
                    pixels(y * w + x) = ((x * 7 + y * 13) Mod 256) / 255.0 + 0.0019
                Next
            Next

            Call PngWriter.WriteGray(file, w, h, pixels)

            Dim raster As RasterImage = PngReader.Decode(file, toGray:=True)
            Dim maxDiff As Double = 0

            For i As Integer = 0 To pixels.Length - 1
                maxDiff = System.Math.Max(maxDiff, System.Math.Abs(pixels(i) - raster.Pixels(i)))
            Next

            Call Check(raster.Width = w AndAlso raster.Height = h AndAlso raster.Channels = 1, $"the raster image = {raster}")
            Call Check(Not raster.IsBlank, "the raster image is not blank")
            Call Check(maxDiff <= 1.0 / 255.0 + 1.0E-9, $"max|diff| = {maxDiff:E3} of the 8 bits quantization")

            ' the pgm output of the same buffer
            Dim pgm As String = IO.Path.Combine(IO.Path.GetTempPath(), "png_self_test", "gray.pgm")

            Call PngWriter.WritePgm(pgm, w, h, pixels)

            Dim head As String = $"P5{Chr(10)}{w} {h}{Chr(10)}255{Chr(10)}"
            Dim read As String = ""

            Using reader As New IO.StreamReader(pgm)
                read = reader.ReadLine() & "/" & reader.ReadLine() & "/" & reader.ReadLine()
            End Using

            Call Check(read = $"P5/{w} {h}/255", $"the pgm header = {read}")
            Call Check(New IO.FileInfo(pgm).Length = head.Length + w * h, "the pgm payload is written")

            ' the gray scale intensity matrix
            Dim image As PngImage = PngReader.Load(file)
            Dim matrix As Double()() = image.Gray

            Call Check(matrix.Length = h AndAlso matrix(0).Length = w, $"the gray matrix = [{matrix.Length} x {matrix(0).Length}]")
            Call Check(matrix(1)(2) = image.Pixels(1 * w + 2) / 255.0, $"the gray matrix value = {matrix(1)(2):F4}")
        End Sub

        ''' <summary>
        ''' a broken png image file should be rejected with an 
        ''' <see cref="IO.InvalidDataException"/>.
        ''' </summary>
        Private Sub TestErrorHandling()
            Call Section("error handling")

            Dim sample As Byte() = Convert.FromBase64String(PngTestData.Vectors.All(0).Data)
            Dim broken As Byte()

            broken = DirectCast(sample.Clone(), Byte())
            broken(2) = 0

            Call Check(Rejects(Function() PngReader.Decode(broken)), "a broken png signature is rejected")

            broken = New Byte(sample.Length - 20) {}
            Call Array.ConstrainedCopy(sample, 0, broken, 0, broken.Length)

            Call Check(Rejects(Function() PngReader.Decode(broken)), "a truncated png image is rejected")

            broken = New Byte(10) {}
            Call Array.Copy(New Byte() {&H89, &H50, &H4E, &H47, &HD, &HA, &H1A, &HA}, broken, 8)

            Call Check(Rejects(Function() PngReader.Decode(broken)), "a png file without the IHDR chunk is rejected")

            broken = DirectCast(sample.Clone(), Byte())
            broken(broken.Length - 1) = CByte(broken(broken.Length - 1) Xor &HFF)

            Call Check(Rejects(Function() PngReader.Decode(broken, verifyCrc:=True)), "a mismatched CRC32 checksum is rejected")
            Call Check(Not Rejects(Function() PngReader.Decode(broken)), "the same image is still loaded when the CRC32 check is disabled")
        End Sub

        ''' <summary>
        ''' (x*7 + y*13 + c*29) Mod 256, the same pixel value function that is 
        ''' used by the independent reference encoder.
        ''' </summary>
        Private Function MakePixels(w As Integer, h As Integer, channels As Integer) As Byte()
            Dim buffer As Byte() = New Byte(w * h * channels - 1) {}

            For y As Integer = 0 To h - 1
                For x As Integer = 0 To w - 1
                    For c As Integer = 0 To channels - 1
                        buffer((y * w + x) * channels + c) = CByte((x * 7 + y * 13 + c * 29) Mod 256)
                    Next
                Next
            Next

            Return buffer
        End Function

        Private Function ColorTypeOf(channels As Integer) As Integer
            Select Case channels
                Case 1 : Return 0
                Case 2 : Return 4
                Case 3 : Return 2
                Case Else : Return 6
            End Select
        End Function

        Private Function FromHex(hexString As String) As Byte()
            Dim buffer As Byte() = New Byte(hexString.Length \ 2 - 1) {}

            For i As Integer = 0 To buffer.Length - 1
                buffer(i) = Convert.ToByte(hexString.Substring(i * 2, 2), 16)
            Next

            Return buffer
        End Function

        Private Function SameBytes(a As Byte(), b As Byte()) As Boolean
            If a Is Nothing OrElse b Is Nothing Then
                Return a Is Nothing AndAlso b Is Nothing
            End If
            If a.Length <> b.Length Then
                Return False
            End If

            For i As Integer = 0 To a.Length - 1
                If a(i) <> b(i) Then
                    Return False
                End If
            Next

            Return True
        End Function

        Private Function FirstDiff(a As Byte(), b As Byte()) As Integer
            Dim n As Integer = System.Math.Min(If(a Is Nothing, 0, a.Length), If(b Is Nothing, 0, b.Length))

            For i As Integer = 0 To n - 1
                If a(i) <> b(i) Then
                    Return i
                End If
            Next

            Return -1
        End Function

        Private Function Rejects(action As Func(Of PngImage)) As Boolean
            Try
                Dim image As PngImage = action()
                Return False
            Catch ex As Exception
                Return TypeOf ex Is IO.InvalidDataException
            End Try
        End Function

        Private Sub Section(title As String)
            Call Console.WriteLine($"   * {title}")
        End Sub

        Private Sub Check(condition As Boolean, message As String)
            If condition Then
                Call Console.WriteLine($"   [ok]   {message}")
            Else
                failures += 1
                Call Console.WriteLine($"   [FAIL] {message}")
            End If
        End Sub

    End Module

End Namespace

Namespace PngTestData

    ''' <summary>
    ''' The known answer test vectors of the png image decoding, every sample
    ''' is generated by an independent png encoder implementation so that the
    ''' png decoder of this runtime is not verified by itself.
    ''' </summary>
    Public Class Vector

        Public Property Name As String
        Public Property Width As Integer
        Public Property Height As Integer
        Public Property Channels As Integer
        Public Property BitDepth As Integer
        Public Property ColorType As Integer
        Public Property Interlace As Integer
        ''' <summary>the tRNS chunk of the sample is expanded into an alpha channel or not.</summary>
        Public Property ExpandTrns As Boolean
        ''' <summary>the hex string of the expected decoded pixel buffer.</summary>
        Public Property Pixels As String
        ''' <summary>the base64 string of the png image file bytes.</summary>
        Public Property Data As String

    End Class


Imports System.Text

Namespace ApplicationServices.Report

    ''' <summary>
    ''' The base class of the text report renderer: converts a sequence of <see cref="Block"/>
    ''' into a target text format, such as the markdown text or the html text. The rendered
    ''' document text can be read from the <see cref="Output"/> property after the
    ''' <see cref="ReportRender.Render"/> method has been called.
    ''' </summary>
    Public MustInherit Class TextReportRender : Inherits ReportRender

        ''' <summary>
        ''' the text buffer of the current rendered document
        ''' </summary>
        Protected ReadOnly buffer As New StringBuilder()

        ''' <summary>
        ''' the document text that generated by the <see cref="ReportRender.Render"/> method
        ''' </summary>
        ''' <returns></returns>
        Public ReadOnly Property Output As String
            Get
                Return buffer.ToString
            End Get
        End Property

        ''' <summary>
        ''' join the block fragments as a document text, each block fragment are separated
        ''' by a blank line and the empty fragment will be skipped.
        ''' </summary>
        ''' <param name="parts">the text fragment of each block</param>
        Protected Sub AppendBlocks(parts As IEnumerable(Of String))
            Dim isEmpty As Boolean = True

            For Each part As String In parts
                If String.IsNullOrEmpty(part) Then
                    Continue For
                End If
                If Not isEmpty Then
                    Call buffer.Append(vbCrLf & vbCrLf)
                End If

                Call buffer.Append(part)

                isEmpty = False
            Next
        End Sub

        ''' <summary>
        ''' get the smaller one of the two given integer values. (the <c>Math</c> name may be
        ''' shadowed by the <c>Microsoft.VisualBasic.Math</c> namespace in this assembly)
        ''' </summary>
        ''' <param name="a"></param>
        ''' <param name="b"></param>
        ''' <returns></returns>
        Protected Shared Function MinInt(a As Integer, b As Integer) As Integer
            Return If(a < b, a, b)
        End Function
    End Class
End Namespace

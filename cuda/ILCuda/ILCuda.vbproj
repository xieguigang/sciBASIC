<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Microsoft.VisualBasic.Computing.ILCuda</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <Nullable>disable</Nullable>
    <AssemblyName>Microsoft.VisualBasic.Computing.ILCuda</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Platforms>AnyCPU;x64</Platforms>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Description>纯 Interop 的 VB.NET CUDA 计算框架：设备/上下文/流/显存管理、NVRTC 多通道内核编译、通用归约与线性代数内核。零 NuGet 依赖。</Description>
    <OutputPath>../../.nuget/</OutputPath>
    <Configurations>Debug;Release;nuget_release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="test\**" />
    <EmbeddedResource Remove="test\**" />
    <None Remove="test\**" />
  </ItemGroup>

  <ItemGroup>
    <!--
      CUDA C 内核源码以内嵌资源的形式随框架分发，运行时由 NVRTC 即时编译。
      这里逐个显式列出（而不是用通配符），避免把 emit-kernels 导出的
      合并文件 all.cu 一起打包进来造成内核函数重复定义。
    -->
    <EmbeddedResource Include="Kernels\basic.cu" />
    <EmbeddedResource Include="Kernels\reduce.cu" />
    <EmbeddedResource Include="Kernels\elementwise.cu" />
    <EmbeddedResource Include="Kernels\blas.cu" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\vs_solutions\dev\VisualStudio\VisualStudio.NET5.vbproj" />
  </ItemGroup>

</Project>

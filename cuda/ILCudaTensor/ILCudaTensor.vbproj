<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.VisualBasic.Computing.ILCuda</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <AssemblyName>Microsoft.VisualBasic.Computing.ILCuda.GPUTensor</AssemblyName>
    
    <!-- ILCuda 仅支持 x64，因此这里固定以 x64 目标编译（AnyCPU 平台也产出 x64 程序集） -->
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;Rsharp_app_release;nuget_release</Configurations>
    <OutputPath>../../.nuget</OutputPath>
   
    <Version>10.6.9782.41217</Version>
    <AssemblyVersion>1.0.9782.41217</AssemblyVersion>

    <Title>GPU Tensor Types and CUDA Kernels for the ILCuda Runtime</Title>
    <Description>A GPU tensor extension for sciBASIC#: device-resident dense and CSR sparse tensor storage with host/device caches, hand-written double-precision CUDA kernels for GEMM, softmax, convolution and pooling, plus a CUDA backend for the machine learning tensor compute interface.</Description>
    <PackageTags>scibasic;cuda;gpu-tensor;csr;deep-learning;gpgpu;matmul</PackageTags>
    <PackageReleaseNotes>Introduces the CUDA tensor compute backend with device-resident stores, CSR sparse caches and LIF, LTC and graph layer batch kernels.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AssemblyTitle>Microsoft.VisualBasic.Computing.ILCuda.GPUTensor</AssemblyTitle>
    <Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
    <Company>sciBASIC.NET Foundation</Company>
    <Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
    <PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageIcon>logo-knot.png</PackageIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../.nuget/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="test\**" />
    <EmbeddedResource Remove="test\**" />
    <None Remove="test\**" />
    <None Include="..\..\vs_solutions\logo-knot.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!--
      手写张量内核（double）：末轴 softmax / log-softmax / 归约 / arg 极值。
      以内嵌资源形式随程序集分发，运行时由 CudaTensor.Register 通过
      KernelSources.Register 注入 NVRTC 编译单元。
    -->
    <EmbeddedResource Include="Kernels\tensor.cu" />
    <EmbeddedResource Include="Kernels\gemm.cu" />
    <!--
      手写单精度内核（float32）：两段式全局归约 + CFD 四个扩展原语。
      单精度栈的逐元素 / 标量算子由 FloatKernels.vb 经 IL2Cuda 自动生成，
      只有"块内共享内存归约"与"三维 stencil"这两类 IL2Cuda 表达不了的才放这里。
    -->
    <EmbeddedResource Include="Kernels\tensor_f32.cu" />
    <!--
      CSR 稀疏 × 稠密内核（double）：脉冲神经网络加载真实突触连接组
      （FlyWire 等）时的核心算子，行并行 + atomicAdd(double)。
    -->
    <EmbeddedResource Include="Kernels\spmm.cu" />
    <!--
      手写卷积 / 池化内核（double, NHWC）：前向 + 反向（gradInput / gradFilter /
      gradBias / pool argMax 散射）。同样以内嵌资源分发并在 Register 时注入。
    -->
    <EmbeddedResource Include="Kernels\conv.cu" />
    <EmbeddedResource Include="Kernels\pool.cu" />
    <!--
      手写训练内核（float）：AdamW 原地更新、梯度累加、融合掩码交叉熵。
      IL2Cuda 无法表达"多输出数组"与"块内共享内存归约"，因此与 gemm.cu 一样手写。
    -->
    <EmbeddedResource Include="Kernels\train.cu" />
    <!--
      融合的递归 LIF 单步内核：把「稀疏输入 + 泄漏积分 + 阈值触发 + 复位 + 计数累加」
      压成一次调用，配合设备常驻状态实现每步零主机往返。double 与 float 两个变体。
    -->
    <EmbeddedResource Include="Kernels\lif.cu" />
    <!--
      Cella 批量细胞管线融合内核：把「同一步的全部细胞」当作一个 batch，
      为液态网络 RK4 积分（LNN）与先验调控图消息传递（GNN）各提供一次内核完成，
      配合设备常驻状态消除逐算子往返。
    -->
    <EmbeddedResource Include="Kernels\cellaccel.cu" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Data_science\MachineLearning\TensorFlow\TensorFlow.vbproj" />
    <ProjectReference Include="..\..\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\vs_solutions\dev\VisualStudio\VisualStudio.NET5.vbproj" />
    <ProjectReference Include="..\ILCuda\ILCuda.vbproj" />
  </ItemGroup>

</Project>

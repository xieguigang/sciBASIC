\pard\ql\sl276\slmult1\sb120\sa120\cbpat9\chshdng0\plain\f2\fs20\cf4 Imports Microsoft.VisualBasic.MachineLearning\line Imports Microsoft.VisualBasic.MachineLearning.CNN\line Imports Microsoft.VisualBasic.MachineLearning.CNN.trainers\line \line Dim net As New ConvolutionalNetwork()\line Call net.AddLayer(New ConvolutionLayer(filters:=32, kernelSize:=3))\line Call net.AddLayer(New PoolingLayer(size:=2))\line Call net.AddLayer(New DenseLayer(units:=10))\line Call net.Compile(loss:=New SoftmaxCrossEntropy())\line \line Dim trainer As New SGDTrainer(optimizer:=Optimizer.Adam, learningRate:=0.001)\line \line For epoch As Integer = 1 To 20\line     Call trainer.TrainEpoch(net, trainData)\line Next\par

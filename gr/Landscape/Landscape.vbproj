<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>Microsoft.VisualBasic.Imaging.Landscape</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
		<AssemblyName>Microsoft.VisualBasic.Imaging.Landscape</AssemblyName>
		<Platforms>AnyCPU;x64</Platforms>
		<Configurations>Debug;Release;LipidSearch;Rsharp_app_release;mzkit;NPSearch;mzkit_win32;gcmodeller_desktop;nuget_release</Configurations>

		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>

		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>

		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

		<PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>

		<UseApplicationFramework>True</UseApplicationFramework>

		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<Version>10.7.9782.41243</Version>
		<AssemblyVersion>1.0.9782.41243</AssemblyVersion>
		<Title>3D Mesh Model Parsers with Voxelization and SDF Volumes</Title>
		<Description>A 3D mesh toolkit for sciBASIC#: loads STL, OBJ, glTF/GLB, COLLADA, 3DS and 3MF models into one unified scene model, reads PLY point clouds, then voxelizes surfaces into signed distance volumes with BVH acceleration for CFD simulation grids.</Description>
		<AssemblyTitle>Microsoft.VisualBasic.Imaging.Landscape</AssemblyTitle>
		<Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
		<Company>sciBASIC.NET Foundation</Company>
		<Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
		<PackageTags>scibasic;3d-mesh;stl;obj;gltf;voxelization;sdf</PackageTags>
    <PackageReleaseNotes>Adds glTF/GLB, 3DS and 3MF readers, BVH-accelerated signed distance field generation and anti-aliased column ray casting voxelization for CFD grids.</PackageReleaseNotes>
		<PackageIcon>logo-knot.png</PackageIcon>
		<PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>netcore5=1,UNIX=1</DefineConstants>
	
		<RemoveIntegerChecks>true</RemoveIntegerChecks>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
	</PropertyGroup>



	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='LipidSearch|x64'">
	  <RemoveIntegerChecks>true</RemoveIntegerChecks>
	  <Optimize>false</Optimize>
	  <DebugSymbols>true</DebugSymbols>
	  <DebugType>full</DebugType>
	  <DefineDebug>false</DefineDebug>
	  <DefineTrace>true</DefineTrace>
	  <DefineConstants>netcore5=1,UNIX=1</DefineConstants>
	
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Rsharp_app_release|x64'">
	  <RemoveIntegerChecks>true</RemoveIntegerChecks>
	  <Optimize>false</Optimize>
	  <DebugSymbols>true</DebugSymbols>
	  <DebugType>full</DebugType>
	  <DefineDebug>false</DefineDebug>
	  <DefineTrace>true</DefineTrace>
	  <DefineConstants>netcore5=1,UNIX=1</DefineConstants>
	 
	  <OutputPath></OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='gcmodeller_desktop|x64'">
	  <RemoveIntegerChecks>true</RemoveIntegerChecks>
	  <Optimize>false</Optimize>
	  <DebugSymbols>true</DebugSymbols>
	  <DebugType>full</DebugType>
	  <DefineDebug>false</DefineDebug>
	  <DefineTrace>true</DefineTrace>
	  <DefineConstants>netcore5=1,UNIX=1</DefineConstants>
	 
	  <OutputPath />
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='mzkit_win32|x64'">
	  <RemoveIntegerChecks>true</RemoveIntegerChecks>
	  <Optimize>false</Optimize>
	  <DebugSymbols>true</DebugSymbols>
	  <DebugType>full</DebugType>
	  <DefineDebug>false</DefineDebug>
	  <DefineTrace>true</DefineTrace>
	  <DefineConstants>netcore5=1,UNIX=1</DefineConstants>
	
	  
	</PropertyGroup>



	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='mzkit|x64'">
	  <RemoveIntegerChecks>true</RemoveIntegerChecks>
	  <Optimize>false</Optimize>
	  <DebugSymbols>true</DebugSymbols>
	  <DebugType>full</DebugType>
	  <DefineDebug>false</DefineDebug>
	  <DefineTrace>true</DefineTrace>
	  <DefineConstants>netcore5=1,UNIX=1</DefineConstants>
	
	  <OutputPath>\GCModeller\src\R-sharp\App\</OutputPath>
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
	
	  <RemoveIntegerChecks>true</RemoveIntegerChecks>
	  <Optimize>false</Optimize>
	  <DebugSymbols>true</DebugSymbols>
	  <DebugType>full</DebugType>
	  <DefineDebug>false</DefineDebug>
	  <DefineConstants>netcore5=1,UNIX=1</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
		<PlatformTarget>x64</PlatformTarget>
		<OutputPath>../../.nuget/</OutputPath>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="test\**" />
		<EmbeddedResource Remove="test\**" />
		<None Remove="test\**" />
		<None Include="..\..\vs_solutions\logo-knot.png">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="README.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Import Include="System.Data" />
		<Import Include="System.Resources" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
	  <ProjectReference Include="..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
	  <ProjectReference Include="..\..\mime\text%html\html_netcore5.vbproj" />
	  <ProjectReference Include="..\Microsoft.VisualBasic.Imaging\imaging.NET5.vbproj" />
	</ItemGroup>

</Project>

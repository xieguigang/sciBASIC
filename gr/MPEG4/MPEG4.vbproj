<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.VisualBasic.Imaging.MPEG4</RootNamespace>
    <AssemblyName>Microsoft.VisualBasic.Imaging.MPEG4</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;Rsharp_app_release;LipidSearch;mzkit;NPSearch;mzkit_win32;CellaLAB-Desktop;nuget_release</Configurations>
    <Version>10.7.9782.41243</Version>
    <AssemblyVersion>1.0.9782.41243</AssemblyVersion>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>H.264 Video Encoder and MP4 ISO-BMFF Muxer</Title>
    <Description>A video encoding toolkit for sciBASIC#: encodes RGBA frames with an I-frame H.264 Main profile pipeline (CABAC, intra prediction, integer motion estimation), streams bit-level syntax with RBSP escaping, and muxes samples into MP4 containers with faststart and AVCC NAL packaging.</Description>
    <AssemblyTitle>Microsoft.VisualBasic.Imaging.MPEG4</AssemblyTitle>
    <Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
    <Company>sciBASIC.NET Foundation</Company>
    <Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
    <PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>scibasic;h264;mp4;video-encoding;cabac;iso-bmff</PackageTags>
    <PackageReleaseNotes>Added CABAC entropy coding, integer motion estimation, intra prediction and an MP4 faststart muxer with AVCC sample stores.</PackageReleaseNotes>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageIcon>logo-knot.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../.nuget/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Data\BinaryData\BinaryData\binarydata-netcore5.vbproj" />
    <ProjectReference Include="..\..\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\avi\AVI.NET5.vbproj" />
    <None Include="..\..\vs_solutions\logo-knot.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Microsoft.VisualBasic.Data.visualize.Network.Canvas</RootNamespace>
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <AssemblyName>Microsoft.VisualBasic.Data.visualize.Network.Canvas</AssemblyName>
   
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;Rsharp_app_release;mzkit;mzkit_win32;CellaLAB-Desktop;nuget_release</Configurations>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	  <AssemblyVersion>2.33.9758.20045</AssemblyVersion>
	  <Deterministic>false</Deterministic>
	  <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
	  <ApplicationManifest>My Project\app.manifest</ApplicationManifest>
	  <StartupObject>Microsoft.VisualBasic.Data.visualize.Network.Canvas.My.MyApplication</StartupObject>
	  <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  <UseWindowsForms>true</UseWindowsForms> 
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	  <Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
	  <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
	  <GenerateDocumentationFile>True</GenerateDocumentationFile>
	  <MyType>WindowsForms</MyType>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <Version>1.0.9758.20045</Version>
    <Title>Interactive WinForms Network Graph Viewer Control</Title>
    <Description>A Windows Forms canvas that animates force-directed layouts, supports 2D and 3D rendering, mouse hit-testing, node tooltips and viewport panning, and can record the animation to AVI or SVG for sciBASIC# desktop apps.</Description>
    <AssemblyTitle>Microsoft.VisualBasic.Data.visualize.Network.Canvas</AssemblyTitle>
    <Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
    <Company>sciBASIC.NET Foundation</Company>
    <PackageTags>scibasic;network-canvas;winforms;interactive-viewer;data-visualization;animation</PackageTags>
    <PackageReleaseNotes>An interactive Windows Forms network graph viewer for sciBASIC#. It hosts a laid out NetworkGraph on a WinForms canvas and animates force directed layouts in real time, supporting both 2D and 3D rendering, mouse hit testing, node tooltips, and viewport panning and zooming, with the styling of UI elements kept separate from the graph rendering. The animation produced by a layout can be recorded and exported to AVI (through the AVIMedia package) or to SVG, which makes the control useful both as an interactive explorer and as a way to produce publication ready animations of network evolution.</PackageReleaseNotes>
    <PackageIcon>logo-knot.png</PackageIcon>
    <PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../../.nuget/</OutputPath>
  </PropertyGroup>


  <ItemGroup>
    <None Include="..\..\..\vs_solutions\logo-knot.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

	<ItemGroup>
		<Import Include="System.Data" />
		<Import Include="System.Drawing" />
		<Import Include="System.Windows.Forms" />
		<Import Include="System.Windows.Forms.Design" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\..\Data_science\Graph\graph-netcore5.vbproj" />
	  <ProjectReference Include="..\..\..\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
	  <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
	  <ProjectReference Include="..\..\avi\AVI.NET5.vbproj" />
	  <ProjectReference Include="..\..\Drawing-net4.8\Drawing-net4.8.vbproj" />
	  <ProjectReference Include="..\..\Microsoft.VisualBasic.Imaging\imaging.NET5.vbproj" />
	  <ProjectReference Include="..\..\physics\physics-netcore5.vbproj" />
	  <ProjectReference Include="..\Datavisualization.Network\network_graph-netcore5.vbproj" />
	  <ProjectReference Include="..\Network.IO.Extensions\network_io-netcore5.vbproj" />
	  <ProjectReference Include="..\network_layout\network_layout.vbproj" />
	  <ProjectReference Include="..\Visualizer\networkVisualizer.NET5.vbproj" />
	</ItemGroup>



</Project>

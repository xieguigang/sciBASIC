<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.VisualBasic.Data.visualize.Network.Layouts</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>Microsoft.VisualBasic.Data.visualize.Network.Layouts</AssemblyName>
    <UseApplicationFramework>True</UseApplicationFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;Rsharp_app_release;mzkit_win32;nuget_release;CellaLAB-Desktop</Configurations>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>logo-knot.png</PackageIcon>
    <Version>1.0.9758.20045</Version>
    <AssemblyVersion>1.0.9758.20045</AssemblyVersion>
    <Title>Graph Layout Algorithms For Network Visualization</Title>
    <Description>Supplies force-directed, spring-embedder, constrained Cola, orthogonal, radial, circular, HOLA and edge-bundling layouts behind a common IPlanner interface. Computes node coordinates before rendering sciBASIC# networks.</Description>
    <AssemblyTitle>Microsoft.VisualBasic.Data.visualize.Network.Layouts</AssemblyTitle>
    <Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
    <Company>sciBASIC.NET Foundation</Company>
    <Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
    <PackageTags>scibasic;graph-layout;force-directed;spring-embedder;cola;orthogonal-routing;hola;edge-bundling;radial</PackageTags>
    <PackageReleaseNotes>Graph layout algorithms for network visualization in sciBASIC#, all behind a common IPlanner interface so a layout can be swapped without touching rendering code. Algorithms: force directed and spring embedder layouts (ForceDirected, SpringForce with its Interfaces), the constrained layout engine (Cola) with 3D layout, power graph and grid routing plus geometry and model accessors, orthogonal layout with its optimization passes and utilities, radial and circular layouts, HOLA, and Mingle edge bundling for dense graphs. Usage: a layout consumes a graph and produces node coordinates (the Layouts vector types), which the rendering layer (Visualizer, NetworkCanvas) then draws. Because layouts are pure algorithms over the graph model, they can also be used headlessly to pre-compute coordinates for static images.</PackageReleaseNotes>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <RemoveIntegerChecks>true</RemoveIntegerChecks>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <OutputPath>../../../.nuget/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="LayoutSanityCheck\**" />
    <EmbeddedResource Remove="LayoutSanityCheck\**" />
    <None Remove="LayoutSanityCheck\**" />
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Orthogonal\Main.vb" />
    <Compile Remove="Orthogonal\util\SavePNG.vb" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\vs_solutions\logo-knot.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Data_science\Graph\graph-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\physics\physics-netcore5.vbproj" />
    <ProjectReference Include="..\Datavisualization.Network\network_graph-netcore5.vbproj" />
  </ItemGroup>

</Project>

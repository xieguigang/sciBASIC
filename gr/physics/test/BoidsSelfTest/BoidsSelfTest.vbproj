<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BoidsSelfTest</RootNamespace>
    <AssemblyName>BoidsSelfTest</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- the render cost model writes into a pinned pixel buffer through pointers -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\physics-netcore5.vbproj" />
  </ItemGroup>

</Project>

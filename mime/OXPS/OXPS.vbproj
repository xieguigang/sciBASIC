<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.VisualBasic.MIME.OpenXPS</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyTitle>Microsoft.VisualBasic.MIME.OpenXPS</AssemblyTitle>
    <AssemblyName>Microsoft.VisualBasic.MIME.OpenXPS</AssemblyName>
    <Title>XPS / OXPS Document Generator and Text Extractor</Title>
    <Description>Generates and reads XPS and OpenXPS fixed-page documents for sciBASIC#: a block based writer lays out text, tables and images onto fixed pages with optional ODTTF font embedding, packs them into an OPC package, extracts plain text back out through the Glyphs content streams, and implements the shared ReportRender contract for report generation.</Description>
    <PackageTags>scibasic;xps;oxps;fixedpage;opc;document-generation;text-extraction;markdown</PackageTags>
    <Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
    <Company>sciBASIC.NET Foundation</Company>
    <Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>10.8.9797.36764</Version>
    <AssemblyVersion>1.0.9797.36764</AssemblyVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;nuget_release</Configurations>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Initial release: OpenXPS and Microsoft XPS document writer with automatic line wrapping and pagination, ODTTF font embedding, OPC packaging, Glyphs based text extraction and a report renderer for the shared block model.</PackageReleaseNotes>
    <PackageIcon>logo-knot.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../.nuget/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <None Include="..\..\vs_solutions\logo-knot.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- test 目录为独立的控制台自校验工程（test\test.vbproj），不能编入本库 -->
    <Compile Remove="test\**" />
    <EmbeddedResource Remove="test\**" />
    <None Remove="test\**" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.VisualBasic.MIME.OpenXPS</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyTitle>application/oxps</AssemblyTitle>
    <AssemblyName>Microsoft.VisualBasic.MIME.OpenXPS</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- test 目录为独立的控制台自校验工程（test\test.vbproj），不能编入本库 -->
    <Compile Remove="test\**" />
    <EmbeddedResource Remove="test\**" />
    <None Remove="test\**" />
  </ItemGroup>

</Project>

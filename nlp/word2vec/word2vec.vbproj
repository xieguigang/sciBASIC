<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>

    <TargetFrameworks>net10.0</TargetFrameworks>

		<Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
		<Company>sciBASIC.NET Foundation</Company>
		<Version>5.0.9762.10518</Version>

		<AssemblyVersion>5.33.9762.10518</AssemblyVersion>
		<Deterministic>false</Deterministic>
		<RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-x64</RuntimeIdentifiers>
		<Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>

		<PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>

		<RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
		<Platforms>AnyCPU;x64;x86</Platforms>
		<Configurations>Debug;Release;Rsharp_app_release;LipidSearch;PlantMAT;mzkit;NPSearch;mzkit_win32;gcmodeller_desktop;Docker;CFD_win32;nuget_release</Configurations>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <RemoveIntegerChecks>true</RemoveIntegerChecks>
    <UseApplicationFramework>True</UseApplicationFramework>
    <AssemblyName>Microsoft.VisualBasic.Data.NLP.Word2Vec</AssemblyName>
    <RootNamespace>Microsoft.VisualBasic.Data.NLP.Word2Vec</RootNamespace>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <IncludeSymbols>True</IncludeSymbols>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Title>Word2Vec Embedding Trainer with Skip-Gram and CBOW</Title>
    <Description>Trains word embeddings for sciBASIC#: a multi-threaded Word2Vec using skip-gram and CBOW over Huffman trees, a fluent factory for vector size, window, sampling and thread count, plus vector models for similarity and analogy queries.</Description>
    <AssemblyTitle>Microsoft.VisualBasic.Data.NLP.Word2Vec</AssemblyTitle>
    <PackageTags>scibasic;word2vec;word-embedding;skip-gram;cbow;huffman-tree;word-similarity;machine-learning</PackageTags>
    <PackageReleaseNotes>The Word2Vec word embedding trainer of sciBASIC#. A fluent Word2VecFactory configures vector size, window size, sampling rate, frequency threshold, learning rate and thread count (setVectorSize, setWindow, setSample, setMethod, setNumOfThread) and builds a Word2Vec trainer. Training is multi-threaded and supports both the skip-gram and the CBOW objective (TrainMethod.Skip_Gram / TrainMethod.CBow), implemented over Huffman tree word neurons (WordNeuron) so that frequent words receive short codes. Corpus text is ingested through readTokens - accepting Sentence models or plain token collections - and training runs through training(), with rare words pruned by the configured frequency threshold. The trained set is exposed as a VectorModel via outputVector(), offering nearest neighbour lookup by word or by a raw centre vector through similar(), word vector retrieval through getWordVector(), and analogy resolution of the form word a - word b + word c through analogy(). WordScore carries each ranked neighbour (word name plus score), and Trainer wraps the background training task used by the parallel trainer.</PackageReleaseNotes>
    <PackageIcon>logo-knot.png</PackageIcon>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <RemoveIntegerChecks>true</RemoveIntegerChecks>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <OutputPath>../../.nuget/</OutputPath>
  </PropertyGroup>
	<ItemGroup>
	  <Compile Remove="test\**" />
	  <EmbeddedResource Remove="test\**" />
	  <None Remove="test\**" />
	  <None Include="..\..\vs_solutions\logo-knot.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\..\Data_science\Graph\graph-netcore5.vbproj" />
	  <ProjectReference Include="..\..\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
	  <ProjectReference Include="..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
	  <ProjectReference Include="..\NLP\NLP.NET.vbproj" />
	</ItemGroup>
  </Project>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.VisualBasic.Engine.Physics</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>Microsoft.VisualBasic.Engine.Physics</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;LipidSearch;Rsharp_app_release;mzkit;NPSearch;gcmodeller_desktop;CFD_win32;nuget_release;CellaLAB-Desktop</Configurations>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageIcon>logo-knot.png</PackageIcon>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
    <PackageProjectUrl>http://scibasic.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xieguigang/sciBASIC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <UseApplicationFramework>True</UseApplicationFramework>
    <Version>10.8.9796.18903</Version>
    <AssemblyVersion>1.0.9796.18903</AssemblyVersion>
    <Title>2D and 3D Rigid Body Physics Engine with Joints, Fields and Fluids</Title>
    <Description>A fixed-step rigid body physics engine for sciBASIC#: two and three dimensional worlds with broad and narrow phase collision detection, SAT based convex polyhedron contacts and manifolds, revolute, prismatic, spring, weld, ball and hinge joints, angular motors, gravity / wind / magnetic force fields, plus SPH fluid and boids hooks for particle scenes.</Description>
    <AssemblyTitle>Microsoft.VisualBasic.Engine.Physics</AssemblyTitle>
    <Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
    <Company>sciBASIC.NET Foundation</Company>
    <Copyright>Copyright (c) sciBASIC.NET Foundation</Copyright>
    <PackageTags>scibasic;physics-engine;rigid-body;collision-detection;convex-hull;sat;joints;3d-simulation;sph</PackageTags>
    <PackageReleaseNotes>Adds a three dimensional physics world with SAT based convex polyhedron collision, contact manifolds and sequential impulse solvers, ball / hinge joints and angular motors, while keeping the two dimensional world, force fields and particle hooks.</PackageReleaseNotes>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <RemoveIntegerChecks>true</RemoveIntegerChecks>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <OutputPath>../../.nuget/</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineConstants>netcore5=1</DefineConstants>

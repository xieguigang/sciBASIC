<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ModelViewer</RootNamespace>
    <AssemblyName>ModelViewer</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <UseWPF>True</UseWPF>
    <StartupObject>ModelViewer.MainForm</StartupObject>
    <ApplicationIcon>3mf.ico</ApplicationIcon>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>1.0.9742.7537</Version>
    <AssemblyVersion>1.0.9742.7537</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>G:\GCModeller\src\runtime\sciBASIC#\tools</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <OutputPath>G:\GCModeller\src\runtime\sciBASIC#\tools</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>G:\GCModeller\src\runtime\sciBASIC#\tools</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <OutputPath>G:\GCModeller\src\runtime\sciBASIC#\tools</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="SmokeTest\**" />
    <EmbeddedResource Remove="SmokeTest\**" />
    <None Remove="SmokeTest\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="3mf.ico" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System.Windows.Forms" />
    <Import Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\gr\Drawing-net4.8\Drawing-net4.8.vbproj" />
    <ProjectReference Include="..\..\gr\Landscape\Landscape.vbproj" />
    <ProjectReference Include="..\..\gr\Microsoft.VisualBasic.Imaging\imaging.NET5.vbproj" />
    <ProjectReference Include="..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\mime\text%html\html_netcore5.vbproj" />
  </ItemGroup>

</Project>

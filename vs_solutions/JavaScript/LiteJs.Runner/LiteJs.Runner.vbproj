<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LiteJs.Runner</RootNamespace>
    <AssemblyName>LiteJs.Runner</AssemblyName>
    <LangVersion>latest</LangVersion>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <Platforms>AnyCPU;x64</Platforms>
    <StartupObject>LiteJs.Runner.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\dev\VisualStudio\VisualStudio.NET5.vbproj" />
    <ProjectReference Include="..\LiteJs.vbproj" />
  </ItemGroup>

</Project>

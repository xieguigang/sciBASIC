#End Region

Imports System.Reflection
Imports System.Text

Imports Microsoft.VisualBasic.ApplicationServices.VM.JavaScript.Runtime
Imports doc = Microsoft.VisualBasic.ApplicationServices.Development.XmlDoc.Assembly

Namespace TypeDefinitions

    ''' <summary>Header facts written into the generated file.</summary>
    Friend Class EmitMeta

        Friend Property AssemblyName As String
        Friend Property RuntimeVersion As String
        Friend Property Globals As Boolean
        Friend Property Documents As Boolean
        Friend Property DocumentPath As String

    End Class

    ''' <summary>
    ''' Writes the single self-contained ``.d.ts`` file: header comment, one
    ''' ``declare namespace`` block per CLR namespace (global-namespace types at file
    ''' level, nested types merged through a same-named namespace block), then the
    ''' global alias section. Output is deterministic: namespaces and members are
    ''' sorted and no timestamp is written, so the file can be diffed and committed.
    ''' </summary>
    Friend Module TsEmitter

        Friend Function Emit(types As List(Of TsType), exports As HashSet(Of String),
                             docs As XmlDocIndex, meta As EmitMeta) As String

            Dim sb As New StringBuilder

            EmitHeader(sb, meta)

            Dim groups As IEnumerable(Of IGrouping(Of String, TsType)) = types _
                .Where(Function(t) t.Parent Is Nothing) _
                .GroupBy(Function(t) t.TsNamespace, StringComparer.Ordinal) _
                .OrderBy(Function(g) g.Key, StringComparer.Ordinal)

            For Each group As IGrouping(Of String, TsType) In groups
                Dim indent As String = If(group.Key = "", "", "    ")

                If group.Key <> "" Then
                    sb.AppendLine("declare namespace " & group.Key & " {")
                End If

                For Each model In group.OrderBy(Function(t) t.ShortName, StringComparer.OrdinalIgnoreCase)
                    EmitType(sb, model, indent, exports, docs)
                Next

                If group.Key <> "" Then
                    sb.AppendLine("}")
                    sb.AppendLine()
                End If
            Next

            EmitGlobals(sb, types, meta)

            Return sb.ToString()
        End Function

        ' ======================================================== header

        Private Sub EmitHeader(sb As StringBuilder, meta As EmitMeta)
            sb.AppendLine("//------------------------------------------------------------------------------")
            sb.AppendLine("// <auto-generated>")
            sb.AppendLine("//     This code was generated by the LiteJs TypeScript definition generator.")
            sb.AppendLine("//     DO NOT EDIT THIS FILE — regenerate with: njs --dts <assembly.dll>")
            sb.AppendLine("//")
            sb.AppendLine("//     Assembly  : " & meta.AssemblyName)
            sb.AppendLine("//     Runtime   : " & meta.RuntimeVersion)
            sb.AppendLine("//     Globals   : " & If(meta.Globals, "enabled", "disabled"))
            sb.AppendLine("//     Documents : " & If(meta.Documents, meta.DocumentPath, "none"))
            sb.AppendLine("// </auto-generated>")
            sb.AppendLine("//------------------------------------------------------------------------------")
            sb.AppendLine()
        End Sub

        ' ======================================================== types

        Private Sub EmitType(sb As StringBuilder, model As TsType, indent As String,
                             exports As HashSet(Of String), docs As XmlDocIndex)

            Select Case model.Kind
                Case TsTypeKind.EnumType
                    EmitEnum(sb, model, indent, docs)
                Case TsTypeKind.DelegateType
                    EmitDelegate(sb, model, indent, exports, docs)
                Case Else
                    EmitClassLike(sb, model, indent, exports, docs)
            End Select

            ' nested types merge into a namespace block carrying the outer type name
            If model.Nested.Count > 0 Then
                sb.Append(indent).AppendLine("namespace " & model.ShortName & " {")

                For Each nested In model.Nested.OrderBy(Function(t) t.ShortName, StringComparer.OrdinalIgnoreCase)
                    EmitType(sb, nested, indent & "    ", exports, docs)
                Next

                sb.Append(indent).AppendLine("}")
            End If

            sb.AppendLine()
        End Sub

        Private Sub EmitEnum(sb As StringBuilder, model As TsType, indent As String, docs As XmlDocIndex)
            Dim block As String = JsDocWriter.ForType(
                If(docs Is Nothing, Nothing, docs.TypeDoc(model.ClrType.FullName)),
                model.IsObsolete, DeprecatedOf(model.ClrType), indent)

            If block <> "" Then sb.Append(block)

            sb.Append(indent).Append("enum ").Append(model.ShortName).AppendLine(" {")

            For Each member In model.EnumMembers
                sb.Append(indent).Append("    ").Append(member.Key) _
                  .Append(" = ").Append(member.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)) _
                  .AppendLine(",")
            Next

            sb.Append(indent).AppendLine("}")
        End Sub

        Private Sub EmitDelegate(sb As StringBuilder, model As TsType, indent As String,
                                 exports As HashSet(Of String), docs As XmlDocIndex)

            Dim block As String = JsDocWriter.ForType(
                If(docs Is Nothing, Nothing, docs.TypeDoc(model.ClrType.FullName)),
                model.IsObsolete, DeprecatedOf(model.ClrType), indent)

            If block <> "" Then sb.Append(block)

            Dim generic As String = GenericSuffix(model)

            sb.Append(indent).Append("type ").Append(model.ShortName).Append(generic).Append(" = ")

            If model.Invoke Is Nothing Then
                sb.AppendLine("(...args: any[]) => any;")
            Else
                sb.Append(RenderParameters(model.Invoke.Parameters, exports)) _
                  .Append(" => ") _
                  .Append(TypeMapper.TsTypeName(model.Invoke.ReturnType, exports)) _
                  .AppendLine(";")
            End If
        End Sub

        Private Sub EmitClassLike(sb As StringBuilder, model As TsType, indent As String,
                                  exports As HashSet(Of String), docs As XmlDocIndex)

            Dim block As String = JsDocWriter.ForType(
                If(docs Is Nothing, Nothing, docs.TypeDoc(model.ClrType.FullName)),
                model.IsObsolete, DeprecatedOf(model.ClrType), indent)

            If block <> "" Then sb.Append(block)

            Dim keyword As String = If(model.Kind = TsTypeKind.InterfaceType, "interface", "class")

            sb.Append(indent)

            If keyword = "class" AndAlso model.Kind = TsTypeKind.ClassType AndAlso model.IsAbstract Then
                sb.Append("abstract ")
            End If

            sb.Append(keyword).Append(" ").Append(model.ShortName).Append(GenericSuffix(model))

            ' extends (one base for classes, every interface for interfaces) / implements
            Dim extendsList As New List(Of String)
            Dim implementsList As New List(Of String)

            If model.Kind = TsTypeKind.InterfaceType Then
                For Each i As Type In model.Interfaces
                    Dim name As String = TypeMapper.TsTypeName(i, exports)

                    If name <> "any" AndAlso Not extendsList.Contains(name) Then extendsList.Add(name)
                Next
            Else
                If model.BaseType IsNot Nothing Then
                    extendsList.Add(TypeMapper.TsTypeName(model.BaseType, exports))
                End If

                For Each i As Type In model.Interfaces
                    Dim name As String = TypeMapper.TsTypeName(i, exports)

                    If name <> "any" AndAlso Not extendsList.Contains(name) AndAlso Not implementsList.Contains(name) Then
                        implementsList.Add(name)
                    End If
                Next
            End If

            If extendsList.Count > 0 Then sb.Append(" extends ").Append(String.Join(", ", extendsList))
            If implementsList.Count > 0 Then sb.Append(" implements ").Append(String.Join(", ", implementsList))

            sb.AppendLine(" {")

            Dim inner As String = indent & "    "

            EmitDataMembers(sb, model, inner, exports, docs)
            EmitConstructors(sb, model, inner, exports, docs)
            EmitIndexers(sb, model, inner, exports)
            EmitMethods(sb, model, inner, exports, docs)

            sb.Append(indent).AppendLine("}")
        End Sub

        ' ======================================================== members

        Private Sub EmitDataMembers(sb As StringBuilder, model As TsType, inner As String,
                                    exports As HashSet(Of String), docs As XmlDocIndex)

            ' properties and fields share one member namespace in the bridge: merge
            ' them by name (a field never shadows a same-named property) and sort
            Dim data As New List(Of (Name As String, Type As Type, CanRead As Boolean,
                                     CanWrite As Boolean, IsStatic As Boolean, Info As MemberInfo))

            For Each p As TsProperty In model.Properties
                data.Add((p.Name, p.PropertyType, p.CanRead, p.CanWrite, p.IsStatic, DirectCast(p.Info, MemberInfo)))
            Next

            For Each f As TsField In model.Fields
                If model.Properties.Any(Function(p) String.Equals(p.Name, f.Name, StringComparison.Ordinal)) Then
                    Continue For
                End If

                data.Add((f.Name, f.FieldType, True, Not (f.IsReadOnly OrElse f.IsLiteral), f.IsStatic, DirectCast(f.Info, MemberInfo)))
            Next

            For Each d In data.OrderBy(Function(x) x.Name, StringComparer.OrdinalIgnoreCase)
                Dim memberDoc As doc.ProjectMember = Nothing

                If docs IsNot Nothing AndAlso d.Info IsNot Nothing Then
                    memberDoc = docs.MemberDoc(d.Info)
                End If

                Dim block As String = JsDocWriter.ForMember(memberDoc, IsObsolete(d.Info), DeprecatedOf(d.Info), Nothing, inner)

                If block <> "" Then sb.Append(block)

                Dim staticPrefix As String = If(model.Kind = TsTypeKind.InterfaceType, "",
                                                If(d.IsStatic, "static ", ""))

                If Not d.CanRead AndAlso d.CanWrite Then
                    ' write-only: a plain property type would promise a read the bridge rejects
                    sb.Append(inner).Append(staticPrefix).Append("set ").Append(d.Name) _
                      .Append("(value: ").Append(TypeMapper.TsTypeName(d.Type, exports)).AppendLine(");")
                Else
                    Dim readonlyPrefix As String = If(d.CanRead AndAlso Not d.CanWrite, "readonly ", "")

                    sb.Append(inner).Append(staticPrefix).Append(readonlyPrefix).Append(d.Name) _
                      .Append(": ").Append(TypeMapper.TsTypeName(d.Type, exports)).AppendLine(";")
                End If
            Next
        End Sub

        Private Sub EmitConstructors(sb As StringBuilder, model As TsType, inner As String,
                                     exports As HashSet(Of String), docs As XmlDocIndex)

            If model.Kind = TsTypeKind.InterfaceType OrElse
               model.Kind = TsTypeKind.EnumType OrElse
               model.Kind = TsTypeKind.DelegateType Then
                Return
            End If

            If model.Constructors.Count = 0 Then
                If model.Kind = TsTypeKind.StructType Then
                    ' the bridge builds value types through Activator.CreateInstance
                    sb.Append(inner).AppendLine("constructor();")
                Else
                    ' no public constructor: new T() would fail at runtime, so hide it from TS too
                    sb.Append(inner).AppendLine("private constructor();")
                End If

                Return
            End If

            If model.Kind = TsTypeKind.StructType AndAlso
               Not model.Constructors.Any(Function(c) c.Parameters.Count = 0) Then
                sb.Append(inner).AppendLine("constructor();")
            End If

            For Each ctor In model.Constructors.OrderBy(Function(c) c.Parameters.Count)
                Dim memberDoc As doc.ProjectMember = Nothing

                If docs IsNot Nothing Then memberDoc = docs.MemberDoc(ctor.Info)

                Dim block As String = JsDocWriter.ForMember(memberDoc, IsObsolete(ctor.Info), DeprecatedOf(ctor.Info), Nothing, inner)

                If block <> "" Then sb.Append(block)

                sb.Append(inner).Append("constructor") _
                  .Append(RenderParameters(ctor.Parameters, exports)).AppendLine(";")
            Next
        End Sub

        Private Sub EmitIndexers(sb As StringBuilder, model As TsType, inner As String, exports As HashSet(Of String))
            For Each ix As TsIndexer In model.Indexers
                Dim keyName As String = IndexerKeyName(ix.KeyType)

                If keyName Is Nothing Then Continue For

                Dim readonlyPrefix As String = If(ix.CanRead AndAlso Not ix.CanWrite, "readonly ", "")

                sb.Append(inner).Append(readonlyPrefix).Append("[").Append(keyName).Append("]: ") _
                  .Append(TypeMapper.TsTypeName(ix.ValueType, exports)).AppendLine(";")
            Next
        End Sub

        Private Sub EmitMethods(sb As StringBuilder, model As TsType, inner As String,
                                exports As HashSet(Of String), docs As XmlDocIndex)

            Dim groups As IEnumerable(Of IGrouping(Of String, TsMethod)) = model.Methods _
                .GroupBy(Function(m) m.Name, StringComparer.OrdinalIgnoreCase) _
                .OrderBy(Function(g) g.Key, StringComparer.OrdinalIgnoreCase)

            For Each group As IGrouping(Of String, TsMethod) In groups
                Dim rendered As New HashSet(Of String)(StringComparer.Ordinal)

                For Each m As TsMethod In group.OrderBy(Function(x) x.Parameters.Count)
                    Dim signature As String = RenderSignature(m, model, exports)

                    ' shadowed members can surface twice with an identical signature
                    If Not rendered.Add(signature) Then Continue For

                    Dim memberDoc As doc.ProjectMember = Nothing

                    If docs IsNot Nothing Then memberDoc = docs.MemberDoc(m.Info)

                    Dim block As String = JsDocWriter.ForMember(memberDoc, IsObsolete(m.Info), DeprecatedOf(m.Info),
                                                                OptionalParamNames(m), inner)

                    If block <> "" Then sb.Append(block)

                    sb.Append(inner).Append(signature).AppendLine()
                Next
            Next
        End Sub

        ' ======================================================== signatures

        Private Function RenderSignature(m As TsMethod, model As TsType, exports As HashSet(Of String)) As String
            Dim generic As String = ""

            If m.GenericArguments IsNot Nothing AndAlso m.GenericArguments.Count > 0 Then
                generic = "<" & String.Join(", ", m.GenericArguments) & ">"
            End If

            ' TypeScript interfaces cannot declare static members
            Dim staticPrefix As String = If(model.Kind = TsTypeKind.InterfaceType, "",
                                            If(m.IsStatic, "static ", ""))

            Return staticPrefix & EmitMemberName(m.Name) & generic &
                   RenderParameters(m.Parameters, exports) & ": " &
                   TypeMapper.TsTypeName(m.ReturnType, exports) & ";"
        End Function

        Private Function RenderParameters(params As List(Of TsParameter), exports As HashSet(Of String)) As String
            If params Is Nothing OrElse params.Count = 0 Then Return "()"

            Dim parts As New List(Of String)

            For i As Integer = 0 To params.Count - 1
                Dim p As TsParameter = params(i)
                Dim element As Type = If(p.IsParamArray, p.Type.GetElementType(), p.Type)
                Dim tsType As String = TypeMapper.TsTypeName(element, exports)

                If p.IsParamArray Then
                    parts.Add("..." & p.Name & ": " & tsType & "[]")
                Else
                    parts.Add(p.Name & If(p.IsOptional, "?", "") & ": " & tsType)
                End If
            Next

            Return "(" & String.Join(", ", parts) & ")"
        End Function

        ''' <summary>
        ''' A member literally named ``constructor`` would be parsed as the class
        ''' constructor, so quote it; every other name (reserved words included) is a
        ''' legal TypeScript property name and must stay verbatim to match the bridge.
        ''' </summary>
        Private Function EmitMemberName(name As String) As String
            If String.Equals(name, "constructor", StringComparison.Ordinal) Then
                Return """" & name & """"
            End If

            Return name
        End Function

        Private Function GenericSuffix(model As TsType) As String
            If model.GenericParameters Is Nothing OrElse model.GenericParameters.Count = 0 Then Return ""
            Return "<" & String.Join(", ", model.GenericParameters) & ">"
        End Function

        Private Function IndexerKeyName(keyType As Type) As String
            If keyType Is Nothing Then Return Nothing
            If keyType Is GetType(String) OrElse keyType Is GetType(Char) Then Return "key: string"
            If ClrConvert.IsNumericType(keyType) Then Return "index: number"

            Return Nothing
        End Function

        ''' <summary>Renders ``[name=default]`` for the optional parameters of a method.</summary>
        Private Function OptionalParamNames(m As TsMethod) As Dictionary(Of String, String)
            If m Is Nothing OrElse m.Parameters Is Nothing Then Return Nothing

            Dim map As Dictionary(Of String, String) = Nothing

            For Each p As TsParameter In m.Parameters
                If Not p.IsOptional Then Continue For

                If map Is Nothing Then map = New Dictionary(Of String, String)(StringComparer.Ordinal)

                Dim rendered As String = "[" & p.Name

                If p.HasDefault AndAlso p.DefaultValue IsNot Nothing Then
                    rendered &= "=" & RenderDefault(p.DefaultValue)
                End If

                rendered &= "]"
                map(p.Name) = rendered
            Next

            Return map
        End Function

        Private Function RenderDefault(value As Object) As String
            If TypeOf value Is String Then Return """" & CStr(value) & """"
            If TypeOf value Is Char Then Return """" & CStr(value) & """"
            If TypeOf value Is Boolean Then Return If(CBool(value), "true", "false")

            Try
                Return Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture)
            Catch ex As Exception
                Return "?"
            End Try
        End Function

        ' ======================================================== global aliases

        Private Sub EmitGlobals(sb As StringBuilder, types As List(Of TsType), meta As EmitMeta)
            If Not meta.Globals Then Return

            Dim aliases = types.Where(Function(t) t.Parent Is Nothing AndAlso t.TsNamespace <> "")

            If Not aliases.Any() Then Return

            sb.AppendLine("//------------------------------------------------------------------------------")
            sb.AppendLine("// global aliases: a host publishes a type under its name, so a script")
            sb.AppendLine("// reaches it as a bare identifier (new X() / X.StaticMember)")
            sb.AppendLine("//------------------------------------------------------------------------------")
            sb.AppendLine()

            Dim used As New Dictionary(Of String, String)(StringComparer.Ordinal)

            For Each model In aliases.OrderBy(Function(t) t.ClrType.FullName, StringComparer.Ordinal)
                Dim qualified As String = TsNaming.QualifiedName(model.ClrType)
                Dim winner As String = Nothing

                If used.TryGetValue(model.ShortName, winner) Then
                    ' first declaration wins; the loser keeps its qualified name
                    sb.Append("// skipped global alias '").Append(model.ShortName) _
                      .Append("' (collides with ").Append(winner) _
                      .Append("); use ").Append(qualified).AppendLine(" instead")
                    Continue For
                End If

                used(model.ShortName) = qualified

                Dim generic As String = GenericSuffix(model)

                sb.Append("type ").Append(model.ShortName).Append(generic) _
                  .Append(" = ").Append(qualified).Append(generic).AppendLine(";")

                If model.Kind = TsTypeKind.InterfaceType OrElse model.Kind = TsTypeKind.DelegateType Then
                    Continue For    ' no constructible value for these kinds
                End If

                sb.Append("declare const ").Append(model.ShortName) _
                  .Append(": typeof ").Append(qualified).AppendLine(";")
            Next
        End Sub

        ' ======================================================== helpers

        Private Function IsObsolete(mi As MemberInfo) As Boolean
            If mi Is Nothing Then Return False
            Return mi.GetCustomAttributes(GetType(ObsoleteAttribute), True).Length > 0
        End Function

        Private Function DeprecatedOf(mi As MemberInfo) As String
            If mi Is Nothing Then Return ""

            For Each a In mi.GetCustomAttributes(GetType(ObsoleteAttribute), True)
                Dim oa As ObsoleteAttribute = TryCast(a, ObsoleteAttribute)

                If oa IsNot Nothing AndAlso Not String.IsNullOrEmpty(oa.Message) Then Return oa.Message
            Next

            Return ""
        End Function

    End Module

End Namespace

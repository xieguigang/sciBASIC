    ' Summaries:

    ' The .d.ts generator test suite: emission shapes, the CLR to TypeScript type
    ' mapping table, interop visibility attributes, JSDoc from XML documentation
    ' (compiler generated and hand written), global aliases with collision dedupe,
    ' the option switches and the file writer.

    ' Note: the fixtures live under the test project root namespace LiteJs.Tests,
    ' because Visual Basic prepends RootNamespace to every namespace declaration.

    ' /********************************************************************************/

#End Region

Imports System.IO
Imports System.Reflection
Imports Microsoft.VisualBasic.ApplicationServices.Development.XmlDoc.Assembly
Imports Microsoft.VisualBasic.ApplicationServices.VM.JavaScript.TypeDefinitions
Imports Xunit

Public Class TypeDefinitionTests

    ''' <summary>Generate the .d.ts text of the test assembly itself.</summary>
    Private Shared Function Generate(Optional options As TypeDefinitionOptions = Nothing) As String
        Dim asm As Assembly = GetType(TsWidget).Assembly

        Return TypeDefinitionGenerator.GenerateFrom(asm, asm.Location, If(options, New TypeDefinitionOptions())).Text
    End Function

    ' ======================================================== header / shape

    <Fact>
    Public Sub Header_records_assembly_and_documents()
        Dim text As String = Generate()

        Assert.Contains("// <auto-generated>", text)
        Assert.Contains("//     Assembly  : " & GetType(TsWidget).Assembly.FullName, text)
        Assert.Contains("//     Globals   : enabled", text)
        ' the compiler generated XML documentation sits next to the dll and is picked up
        Assert.DoesNotContain("Documents : none", text)
    End Sub

    <Fact>
    Public Sub Fixture_types_are_emitted()
        Dim text As String = Generate()

        Assert.Contains("class TsWidget implements LiteJs.Tests.TsDemo.Generic.TsShape {", text)
        Assert.Contains("class TsPoint {", text)
        Assert.Contains("class TsWhitelist {", text)
        Assert.Contains("class TsToolkit {", text)
        Assert.Contains("enum TsState {", text)
        Assert.Contains("type TsTransform = (value: number) => string;", text)
        ' every type also gets a global alias
        Assert.Contains("type TsWidget = LiteJs.Tests.TsWidget;", text)
    End Sub

    <Fact>
    Public Sub Namespaced_types_and_nested_merge()
        Dim text As String = Generate()

        Assert.Contains("declare namespace LiteJs.Tests.TsDemo.Inner {", text)
        Assert.Contains("declare namespace LiteJs.Tests.TsDemo.Other {", text)
        Assert.Contains("declare namespace LiteJs.Tests.TsDemo.Generic {", text)
        Assert.Contains("class TsBox<T> {", text)
        Assert.Contains("interface TsShape {", text)
        ' nested types merge into a namespace block carrying the outer type name
        Assert.Contains("namespace TsOuter {", text)
        Assert.Contains("class TsInner {", text)
    End Sub

    <Fact>
    Public Sub Enum_members_keep_declared_values()
        Dim text As String = Generate()

        Assert.Contains("Idle = 0,", text)
        Assert.Contains("Running = 1,", text)
        Assert.Contains("Paused = 2,", text)
    End Sub

    ' ======================================================== type mapping table

    <Fact>
    Public Sub Type_mapping_follows_the_bridge_conversion_semantics()
        Dim text As String = Generate()

        Assert.Contains("Name: string;", text)
        Assert.Contains("readonly Count: number;", text)
        ' enums cross the bridge as numbers (ClrConvert.ToJs), so the member type
        ' is number — the enum declaration still gives TsState.Running completion
        Assert.Contains("State: number;", text)
        Assert.Contains("readonly Stamp: Date;", text)
        Assert.Contains("readonly Token: string;", text)
        Assert.Contains("readonly Items: number[];", text)
        Assert.Contains("Counter: number;", text)
        Assert.Contains("static readonly MaxCount: number;", text)
        Assert.Contains("Score: number | null;", text)
        Assert.Contains("FetchAsync(): Promise<number>;", text)
        Assert.Contains("MapIt(selector: any): number;", text)
        ' a write-only property becomes a setter (reading it is a runtime TypeError)
        Assert.Contains("set WriteOnlyValue(value: number);", text)
        ' single-parameter indexers become index signatures
        Assert.Contains("readonly [index: number]: string;", text)
    End Sub

    <Fact>
    Public Sub Method_signatures_cover_overloads_params_and_optionals()
        Dim text As String = Generate()

        Assert.Contains("Add(a: number, b: number): number;", text)
        Assert.Contains("Add(a: string, b: string): string;", text)
        Assert.Contains("SumAll(...values: number[]): number;", text)
        Assert.Contains("Greet(name?: string): string;", text)
        Assert.Contains("Area(): number;", text)
        Assert.Contains("static Create(): LiteJs.Tests.TsWidget;", text)
        Assert.Contains("static StaticLabel: string;", text)
    End Sub

    <Fact>
    Public Sub Constructors_and_static_only_types()
        Dim text As String = Generate()

        Assert.Contains("constructor();", text)
        Assert.Contains("constructor(name: string);", text)
        ' a struct keeps the parameterless form the bridge builds with Activator
        Assert.Contains("constructor(x: number, y: number);", text)
        ' a VB Module has no public constructor
        Assert.Contains("private constructor();", text)
    End Sub

    <Fact>
    Public Sub Generic_types_and_methods()
        Dim text As String = Generate()

        ' VB emits "As TsBox(Of T)" on a member of TsBox(Of T) as the unbound
        ' definition: the enclosing type parameters are substituted back
        Assert.Contains("static Box(value: T): LiteJs.Tests.TsDemo.Generic.TsBox<T>;", text)
        Assert.Contains("Self(): LiteJs.Tests.TsDemo.Generic.TsBox<T>;", text)
        ' a method generic parameter keeps its own name
        Assert.Contains("Map<U>(selector: any): LiteJs.Tests.TsDemo.Generic.TsBox<U>;", text)
        ' concrete arguments render as mapped types
        Assert.Contains("WrapInt(v: number): LiteJs.Tests.TsDemo.Generic.TsBox<number>;", text)
        Assert.Contains("TypedBox: LiteJs.Tests.TsDemo.Generic.TsBox<number>;", text)
        ' positional substitution follows the declaring type parameters
        Assert.Contains("BoxFirst(): LiteJs.Tests.TsDemo.Generic.TsBox<A>;", text)
        Assert.Contains("BoxSecond(): LiteJs.Tests.TsDemo.Generic.TsBox<B>;", text)
    End Sub

    ' ======================================================== visibility

    <Fact>
    Public Sub Visibility_attributes_match_the_bridge()
        Dim text As String = Generate()

        ' JsName renames, JsIgnore hides
        Assert.Contains("renamed: string;", text)
        Assert.DoesNotContain("OriginalName", text)
        Assert.DoesNotContain("Hidden:", text)
        ' one JsExpose member switches the whole type to whitelist mode
        Assert.Contains("Visible: string;", text)
        Assert.Contains("VisibleMethod(): string;", text)
        Assert.DoesNotContain("Invisible:", text)
        Assert.DoesNotContain("InvisibleMethod", text)
    End Sub

    <Fact>
    Public Sub Explicit_only_option_forces_whitelist_everywhere()
        Dim options As New TypeDefinitionOptions With {.ExplicitOnly = True}
        Dim text As String = Generate(options)

        Assert.Contains("Visible: string;", text)
        Assert.DoesNotContain("Stamp: Date;", text)
        Assert.DoesNotContain("Greet(name?: string)", text)
    End Sub

    ' ======================================================== JSDoc

    <Fact>
    Public Sub Jsdoc_comes_from_the_compiler_xml_documentation()
        Dim text As String = Generate()

        Assert.Contains("Display name of the widget.", text)
        Assert.Contains("@param a The first operand.", text)
        Assert.Contains("@param b The second operand.", text)
        Assert.Contains("@returns The integer sum.", text)
        ' the default value of an optional parameter is rendered JSDoc style
        Assert.Contains("@param [name=""world""] Who to greet.", text)
        ' [Obsolete] becomes @deprecated even when the member has no summary
        Assert.Contains("@deprecated use Area instead", text)
    End Sub

    <Fact>
    Public Sub Jsdoc_matches_members_by_documented_signature()
        ' note: the local must not be named path — VB is case insensitive and it
        ' would shadow the System.IO.Path type
        Dim docPath As String = System.IO.Path.Combine(System.IO.Path.GetTempPath(), "lits-dts-handwritten.xml")

        File.WriteAllText(docPath,
            "<?xml version=""1.0""?>" & vbCrLf &
            "<doc>" & vbCrLf &
            "    <assembly>" & vbCrLf &
            "        <name>LiteJs.Tests</name>" & vbCrLf &
            "    </assembly>" & vbCrLf &
            "    <members>" & vbCrLf &
            "        <member name=""M:TsWidget.Greet(System.String)"">" & vbCrLf &
            "            <summary>The crafted summary of Greet.</summary>" & vbCrLf &
            "            <param name=""name"">who to greet, precisely</param>" & vbCrLf &
            "            <returns>the crafted greeting</returns>" & vbCrLf &
            "        </member>" & vbCrLf &
            "        <member name=""M:TsWidget.SumAll(System.Int32[])"">" & vbCrLf &
            "            <summary>The crafted variadic summary.</summary>" & vbCrLf &
            "        </member>" & vbCrLf &
            "    </members>" & vbCrLf &
            "</doc>")

        Try
            Dim options As New TypeDefinitionOptions With {.XmlDocPath = docPath}
            Dim text As String = Generate(options)

            ' the signature carries no namespace prefix here: the member is matched
            ' through the name + parameter count fallback
            Assert.Contains("The crafted summary of Greet.", text)
            Assert.Contains("@param [name=""world""] who to greet, precisely", text)
            Assert.Contains("@returns the crafted greeting", text)
            ' array parameter keys are rendered the way the compiler writes them
            Assert.Contains("The crafted variadic summary.", text)
        Finally
            If File.Exists(docPath) Then File.Delete(docPath)
        End Try
    End Sub

    <Fact>
    Public Sub Missing_xml_documentation_degrades_gracefully()
        Dim asm As Assembly = GetType(TsWidget).Assembly
        Dim missing As String = System.IO.Path.Combine(System.IO.Path.GetTempPath(), "lits-dts-missing-" & Guid.NewGuid().ToString("N") & ".xml")
        Dim options As New TypeDefinitionOptions With {.XmlDocPath = missing}

        Dim result = TypeDefinitionGenerator.GenerateFrom(asm, asm.Location, options)

        Assert.False(result.XmlDocLoaded)
        Assert.Contains("class TsWidget implements LiteJs.Tests.TsDemo.Generic.TsShape {", result.Text)
        Assert.DoesNotContain("Display name of the widget.", result.Text)
    End Sub

    ' ======================================================== global aliases

    <Fact>
    Public Sub Global_aliases_and_collision_dedupe()
        Dim text As String = Generate()

        Assert.Contains("type TsNamespaced = LiteJs.Tests.TsDemo.Inner.TsNamespaced;", text)
        Assert.Contains("declare const TsNamespaced: typeof LiteJs.Tests.TsDemo.Inner.TsNamespaced;", text)
        ' the second simple name loses: a comment points at the qualified form
        Assert.Contains("skipped global alias 'TsNamespaced' (collides with LiteJs.Tests.TsDemo.Inner.TsNamespaced)", text)
        ' generics keep their type parameter list
        Assert.Contains("type TsBox<T> = LiteJs.Tests.TsDemo.Generic.TsBox<T>;", text)
        Assert.Contains("declare const TsBox: typeof LiteJs.Tests.TsDemo.Generic.TsBox;", text)
        ' an interface has no constructible value: type alias only
        Assert.Contains("type TsShape = LiteJs.Tests.TsDemo.Generic.TsShape;", text)
        Assert.DoesNotContain("declare const TsShape", text)
    End Sub

    <Fact>
    Public Sub No_globals_option_skips_the_alias_section()
        Dim options As New TypeDefinitionOptions With {.Globals = False}
        Dim text As String = Generate(options)

        Assert.DoesNotContain("global aliases", text)
        Assert.DoesNotContain("declare const TsNamespaced", text)
        ' the namespace declarations stay
        Assert.Contains("declare namespace LiteJs.Tests.TsDemo.Inner {", text)
    End Sub

    ' ======================================================== determinism / IO

    <Fact>
    Public Sub Output_is_deterministic()
        Assert.Equal(Generate(), Generate())
    End Sub

    <Fact>
    Public Sub Write_saves_utf8_without_bom()
        Dim core As Assembly = GetType(ProjectSpace).Assembly
        Dim source As String = core.Location
        Dim copy As String = System.IO.Path.Combine(System.IO.Path.GetTempPath(), "lits-dts-copy.dll")
        Dim out As String = System.IO.Path.Combine(System.IO.Path.GetTempPath(), "lits-dts-copy.d.ts")

        File.Copy(source, copy, overwrite:=True)

        Try
            Dim result = TypeDefinitionGenerator.Write(copy, out, New TypeDefinitionOptions())

            Assert.True(result.TypeCount > 100)
            Assert.True(File.Exists(out))
            Assert.Equal(result.Text, File.ReadAllText(out))

            Dim bytes() As Byte = File.ReadAllBytes(out)

            ' UTF-8 without BOM
            Assert.False(bytes.Length >= 3 AndAlso bytes(0) = &HEF AndAlso bytes(1) = &HBB AndAlso bytes(2) = &HBF)
        Finally
            If File.Exists(copy) Then File.Delete(copy)
            If File.Exists(out) Then File.Delete(out)
        End Try
    End Sub

    ' ======================================================== end to end

    <Fact>
    Public Sub End_to_end_real_assembly_with_xml_documentation()
        Dim asm As Assembly = GetType(ProjectSpace).Assembly
        Dim result = TypeDefinitionGenerator.GenerateFrom(asm, asm.Location, New TypeDefinitionOptions())

        Assert.True(result.XmlDocLoaded)
        Assert.True(result.TypeCount > 100)
        Assert.True(result.MemberCount > 1000)
        Assert.Contains("declare namespace Microsoft.VisualBasic {", result.Text)
        ' a dotted namespace is emitted as a single declaration
        Assert.Contains("declare namespace Microsoft.VisualBasic.ApplicationServices.Development.XmlDoc.Assembly {", result.Text)
        ' a BCL interface maps to Iterable<T>, which is legal under implements
        Assert.Contains("class ProjectSpace implements Iterable<Microsoft.VisualBasic.ApplicationServices.Development.XmlDoc.Assembly.Project> {", result.Text)
    End Sub

End Class

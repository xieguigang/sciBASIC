<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>njs</RootNamespace>
    <AssemblyName>njs</AssemblyName>
    <LangVersion>latest</LangVersion>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <Platforms>AnyCPU;x64</Platforms>
    <OutputPath>../../.nuget/</OutputPath>
    <AssemblyTitle>JavaScript Interpreter Running on .NET CLR</AssemblyTitle>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\mime\application%json\JSON-netcore5.vbproj" />
    <ProjectReference Include="..\dev\VisualStudio\VisualStudio.NET5.vbproj" />
    <ProjectReference Include="..\JavaScript\LiteJs.vbproj" />
  </ItemGroup>

  <!--
    The standard library (stdlib) renders its charts through the skia based raster driver, so the
    host has to ship the skia native asset: a script that imports
    '../../.nuget/net10.0/stdlib.dll' would otherwise fail with
    'The type initializer for SkiaSharp.SKImageInfo threw an exception', because the native
    library of an assembly loaded from outside the application base is not probed by the
    default load context.
  -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.153.1" />
  </ItemGroup>

</Project>
